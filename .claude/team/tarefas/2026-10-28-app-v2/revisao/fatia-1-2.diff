+
+  return (
+    <Box
+      testID={testID}
+      backgroundColor="surfaceHigh"
+      borderRadius={radius}
+      overflow="hidden"
+      {...props}
+      opacity={reduced ? motion.shimmer.reducedOpacity : props.opacity}
+    >
+      {shimmer && !reduced ? (
+        <ShimmerBand progress={shimmer.progress} testID={testID} />
+      ) : null}
+    </Box>
+  );
