+    for (const [name, value] of Object.entries(theme.colors)) {
+      expect({ name, ok: allowed.has(value) }).toEqual({ name, ok: true });
+    }
+  });
+
+  it('cores novas da v2 (1.2)', () => {
+    expect(theme.colors).toMatchObject({
+      background: '#000000',
+      surfaceSunken: '#0B0B0B',
