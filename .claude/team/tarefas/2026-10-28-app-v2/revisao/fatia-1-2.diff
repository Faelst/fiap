+      warningMuted: '#352B1B',
+      text: '#FFFFFF',
+      textSecondary: '#B3B3B3',
+      textTertiary: '#8C8C8C',
+      textDisabled: '#808080',
+      textOnPrimary: '#000000',
+    });
+  });
+
+  it('as cores com alfa ficam fora de `colors`', () => {
