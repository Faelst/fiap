@@ -0,0 +1,214 @@
+import { act, renderHook } from '@testing-library/react-native';
+import {
+  Dimensions,
+  Keyboard,
+  Platform,
+  type KeyboardEvent,
+  type LayoutChangeEvent,
+} from 'react-native';
+import { useReducedMotion } from 'react-native-reanimated';
+
+import { revealOffset, useKeyboardReveal } from '../useKeyboardReveal';
+
+jest.mock('react-native-reanimated', () => ({
+  ...jest.requireActual('react-native-reanimated/mock'),
+  useReducedMotion: jest.fn(() => false),
+}));
+
+describe('revealOffset', () => {
+  const base = { viewportTop: 20, margin: 16 };
+
+  it('alvo visível acima do teclado: não rola', () => {
+    // Fundo do alvo em 400 do conteúdo; janela visível até 500 − 20.
+    expect(
+      revealOffset({
+        ...base,
+        targetBottom: 400,
+        keyboardTop: 500,
+        scrollY: 0,
+      }),
+    ).toBeNull();
+  });
+
+  it('alvo atrás do teclado: rola até ele ficar `margin` acima', () => {
+    // Precisa ver 600 + 16 = 616; vê até 0 + 480 − 20 = 460 → rola 156.
+    expect(
+      revealOffset({
+        ...base,
+        targetBottom: 600,
+        keyboardTop: 480,
+        scrollY: 0,
+      }),
+    ).toBe(156);
+  });
+
+  it('conta a rolagem que já existe', () => {
+    expect(
+      revealOffset({
+        ...base,
+        targetBottom: 600,
+        keyboardTop: 480,
+        scrollY: 100,
+      }),
+    ).toBe(156);
+    expect(
+      revealOffset({
+        ...base,
+        targetBottom: 600,
+        keyboardTop: 480,
+        scrollY: 200,
+      }),
+    ).toBeNull();
+  });
+});
+
+describe('useKeyboardReveal', () => {
+  const windowHeight = Dimensions.get('window').height;
+  let listeners: Record<string, (event: KeyboardEvent) => void>;
+
+  const keyboardEvent = (screenY: number) =>
+    ({
+      endCoordinates: {
+        screenY,
+        height: windowHeight - screenY,
+        screenX: 0,
+        width: 0,
+      },
+    } as KeyboardEvent);
+
+  const layout = (y: number, height: number) =>
+    ({
+      nativeEvent: { layout: { x: 0, y, width: 300, height } },
+    } as LayoutChangeEvent);
+
+  const setup = async () => {
+    const scrollTo = jest.fn();
+    const hook = await renderHook(() =>
+      useKeyboardReveal({ viewportTop: 0, margin: 16 }),
+    );
+    // A ScrollView real não existe no renderHook.
+    (hook.result.current.scrollRef as { current: unknown }).current = {
+      scrollTo,
+    };
+    await act(() => hook.result.current.onTargetLayout(layout(800, 400)));
+    return { ...hook, scrollTo };
+  };
+
+  beforeEach(() => {
+    listeners = {};
+    jest.mocked(useReducedMotion).mockReturnValue(false);
+    jest.spyOn(Keyboard, 'addListener').mockImplementation(((
+      name: string,
+      callback: (event: KeyboardEvent) => void,
+    ) => {
+      listeners[name] = callback;
+      return { remove: jest.fn() };
+    }) as unknown as typeof Keyboard.addListener);
+  });
+
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  describe('no iOS', () => {
+    beforeEach(() => {
+      jest.replaceProperty(Platform, 'OS', 'ios');
+    });
+
+    it('com o alvo armado, o teclado subindo rola até o fim do alvo', async () => {
+      const { result, scrollTo } = await setup();
+      await act(() => result.current.armed.onFocus());
+
+      // Alvo de 800 a 1200; teclado a partir de 900: rola 1216 − 900.
+      await act(() => listeners.keyboardWillShow(keyboardEvent(900)));
+
+      expect(scrollTo).toHaveBeenCalledWith({ y: 316, animated: true });
+    });
+
+    it('sem o alvo armado (outro campo com foco), o teclado não rola nada', async () => {
+      const { scrollTo } = await setup();
+
+      await act(() => listeners.keyboardWillShow(keyboardEvent(900)));
+
+      expect(scrollTo).not.toHaveBeenCalled();
+    });
+
+    it('com o teclado já aberto, armar o alvo rola na hora', async () => {
+      const { result, scrollTo } = await setup();
+      await act(() => listeners.keyboardWillShow(keyboardEvent(900)));
+
+      await act(() => result.current.armed.onFocus());
+
+      expect(scrollTo).toHaveBeenCalledWith({ y: 316, animated: true });
+    });
+
+    it('depois do blur, o teclado não rola mais', async () => {
+      const { result, scrollTo } = await setup();
+      await act(() => result.current.armed.onFocus());
+      await act(() => result.current.armed.onBlur());
+
+      await act(() => listeners.keyboardWillShow(keyboardEvent(900)));
+
+      expect(scrollTo).not.toHaveBeenCalled();
+    });
+
+    it('com reduzir movimento rola sem animação', async () => {
+      jest.mocked(useReducedMotion).mockReturnValue(true);
+      const { result, scrollTo } = await setup();
+      await act(() => result.current.armed.onFocus());
+
+      await act(() => listeners.keyboardWillShow(keyboardEvent(900)));
+
+      expect(scrollTo).toHaveBeenCalledWith({ y: 316, animated: false });
+    });
+
+    it('o espaço do teclado é do sistema (automaticallyAdjustKeyboardInsets): inset 0', async () => {
+      const { result } = await setup();
+
+      await act(() => listeners.keyboardWillShow(keyboardEvent(900)));
+
+      expect(result.current.keyboardInset).toBe(0);
+    });
+  });
+
+  describe('no Android (edge-to-edge)', () => {
+    beforeEach(() => {
+      jest.replaceProperty(Platform, 'OS', 'android');
+    });
+
+    it('o teclado abre espaço embaixo da rolagem e some ao fechar', async () => {
+      const { result } = await setup();
+
+      await act(() => listeners.keyboardDidShow(keyboardEvent(900)));
+      expect(result.current.keyboardInset).toBe(windowHeight - 900);
+
+      await act(() => listeners.keyboardDidHide(keyboardEvent(windowHeight)));
+      expect(result.current.keyboardInset).toBe(0);
+    });
+
+    it('com o alvo armado, rola até o fim do alvo', async () => {
+      const { result, scrollTo } = await setup();
+      await act(() => result.current.armed.onFocus());
+
+      await act(() => listeners.keyboardDidShow(keyboardEvent(900)));
+
+      expect(scrollTo).toHaveBeenCalledWith({ y: 316, animated: true });
+    });
+  });
+
+  it('acompanha a rolagem atual', async () => {
+    jest.replaceProperty(Platform, 'OS', 'ios');
+    const { result, scrollTo } = await setup();
+    await act(() =>
+      result.current.onScroll({
+        nativeEvent: { contentOffset: { x: 0, y: 400 } },
+      } as Parameters<typeof result.current.onScroll>[0]),
+    );
+    await act(() => result.current.armed.onFocus());
+
+    await act(() => listeners.keyboardWillShow(keyboardEvent(900)));
+
+    // 1216 já está à vista com 400 rolados (400 + 900 = 1300).
+    expect(scrollTo).not.toHaveBeenCalled();
+  });
+});
diff --git a/mobile/src/hooks/useKeyboardReveal.ts b/mobile/src/hooks/useKeyboardReveal.ts
new file mode 100644
index 0000000..c9ac565
--- /dev/null
+++ b/mobile/src/hooks/useKeyboardReveal.ts
@@ -0,0 +1,135 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import {
+  Keyboard,
+  Platform,
+  useWindowDimensions,
+  type KeyboardEvent,
+  type LayoutChangeEvent,
+  type NativeScrollEvent,
+  type NativeSyntheticEvent,
+  type ScrollViewInstance,
+} from 'react-native';
+import { useReducedMotion } from 'react-native-reanimated';
+
+type RevealInput = {
+  /** Fundo do alvo, em coordenadas do conteúdo da rolagem. */
+  targetBottom: number;
+  /** Topo do teclado, em coordenadas da janela (`endCoordinates.screenY`). */
+  keyboardTop: number;
+  /** Topo da área da rolagem na janela. */
+  viewportTop: number;
+  scrollY: number;
+  /** Folga entre o alvo e o teclado. */
+  margin: number;
+};
+
+/**
+ * Quanto rolar para o alvo ficar `margin` acima do teclado, ou `null` se ele
+ * já está à vista. Só desce: nunca rola para cima.
+ */
+export function revealOffset({
+  targetBottom,
+  keyboardTop,
+  viewportTop,
+  scrollY,
+  margin,
+}: RevealInput): number | null {
+  const visibleBottom = scrollY + keyboardTop - viewportTop;
+  const needed = targetBottom + margin;
+  return needed > visibleBottom ? needed - (keyboardTop - viewportTop) : null;
+}
+
+/**
+ * Eventos de teclado por plataforma. No iOS o `will` chega com o quadro
+ * final, a tempo de a rolagem andar junto com o teclado; no Android só
+ * existe o `did`.
+ */
+const keyboardEvents = () =>
+  Platform.OS === 'ios'
+    ? ({ show: 'keyboardWillShow', hide: 'keyboardWillHide' } as const)
+    : ({ show: 'keyboardDidShow', hide: 'keyboardDidHide' } as const);
+
+/**
+ * Mantém um alvo (o fim do card do login, com o botão) acima do teclado
+ * enquanto o campo "armado" tem foco (01-design.md da v2, 3.2). Sem
+ * `KeyboardAvoidingView`, para nada se mexer no 1º frame:
+ * - iOS: a `ScrollView` usa `automaticallyAdjustKeyboardInsets` (o sistema
+ *   abre o espaço embaixo) e este hook só rola até o alvo;
+ * - Android (edge-to-edge, o `adjustResize` não encolhe a janela):
+ *   `keyboardInset` é a altura coberta pelo teclado, para a tela somar ao
+ *   padding de baixo da rolagem, e a mesma conta rola até o alvo.
+ */
+export function useKeyboardReveal({
+  viewportTop,
+  margin,
+}: {
+  viewportTop: number;
+  margin: number;
+}) {
+  const reducedMotion = useReducedMotion();
+  const { height: windowHeight } = useWindowDimensions();
+  const scrollRef = useRef<ScrollViewInstance>(null);
+  const scrollY = useRef(0);
+  const targetBottom = useRef(0);
+  const keyboardTop = useRef<number | null>(null);
+  const armed = useRef(false);
+  const [keyboardInset, setKeyboardInset] = useState(0);
+
+  const reveal = useCallback(() => {
+    if (!armed.current || keyboardTop.current === null) return;
+    const y = revealOffset({
+      targetBottom: targetBottom.current,
+      keyboardTop: keyboardTop.current,
+      viewportTop,
+      scrollY: scrollY.current,
+      margin,
+    });
+    if (y !== null) {
+      scrollRef.current?.scrollTo({ y, animated: !reducedMotion });
+    }
+  }, [viewportTop, margin, reducedMotion]);
+
+  useEffect(() => {
+    const events = keyboardEvents();
+    const show = Keyboard.addListener(events.show, (event: KeyboardEvent) => {
+      keyboardTop.current = event.endCoordinates.screenY;
+      if (Platform.OS === 'android') {
+        setKeyboardInset(
+          Math.max(0, windowHeight - event.endCoordinates.screenY),
+        );
+      }
+      reveal();
+    });
+    const hide = Keyboard.addListener(events.hide, () => {
+      keyboardTop.current = null;
+      setKeyboardInset(0);
+    });
+    return () => {
+      show.remove();
+      hide.remove();
+    };
+  }, [reveal, windowHeight]);
+
+  return {
+    scrollRef,
+    keyboardInset,
+    onScroll: (event: NativeSyntheticEvent<NativeScrollEvent>) => {
+      scrollY.current = event.nativeEvent.contentOffset.y;
+    },
+    /** `onLayout` do alvo, filho direto do conteúdo da rolagem. */
+    onTargetLayout: (event: LayoutChangeEvent) => {
+      const { y, height } = event.nativeEvent.layout;
+      targetBottom.current = y + height;
+    },
+    /** Foco e blur do campo que, com foco, mantém o alvo à vista. */
+    armed: {
+      onFocus: () => {
+        armed.current = true;
+        reveal();
+      },
+      onBlur: () => {
+        armed.current = false;
+      },
+    },
+  };
+}
