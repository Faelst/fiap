+      const { result } = await renderProfile();
+
+      await act(async () => {
+        await result.current.onRefresh();
+      });
+
+      expect(result.current.refreshing).toBe(false);
+      expect(result.current.guardian?.fullName).toBe('Gustavo da Silva');
+    });
+  });
+});
