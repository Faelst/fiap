+      expect(result.current.refreshing).toBe(true);
+
+      await act(async () => release());
+      await waitFor(() => expect(result.current.refreshing).toBe(false));
+      expect(result.current.guardian?.fullName).toBe(
+        'Gustavo Henrique da Silva',
+      );
