+        absences: '0',
+        resultAccessibilityLabel: 'Nota 9,5, 0 faltas',
+        expanded: false,
+      },
+      {
+        key: '1-1',
+        index: 1,
+        name: 'Matemática',
+        grade: '8,0',
+        absences: '2',
+        resultAccessibilityLabel: 'Nota 8,0, 2 faltas',
