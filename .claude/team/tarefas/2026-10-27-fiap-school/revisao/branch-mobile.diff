+    expect(header).toHaveAccessibleName('Língua Portuguesa');
+    expect(header).not.toBeExpanded();
+    expect(header).toHaveStyle({ minHeight: theme.sizes.touchTarget });
+    expect(screen.queryByText('Nota:')).toBeNull();
