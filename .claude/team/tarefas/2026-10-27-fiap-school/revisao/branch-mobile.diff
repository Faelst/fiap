+    element:
+      id: boletim-term-2
+    direction: DOWN
+- tapOn:
+    id: boletim-term-2
+- tapOn:
+    id: boletim-term-2-subject-0
+- scrollUntilVisible:
+    element:
+      id: boletim-term-2-subject-0-result
+    direction: DOWN
+- assertVisible:
+    id: boletim-term-2-subject-0-result
+    text: 'Nota e faltas ainda não lançadas'
+- runFlow:
+    when:
