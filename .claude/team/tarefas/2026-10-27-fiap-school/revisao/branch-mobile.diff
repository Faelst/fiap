@@ -0,0 +1,97 @@
+import { ThemeProvider } from '@shopify/restyle';
+import { act, fireEvent, render, screen } from '@testing-library/react-native';
+import BootSplash from 'react-native-bootsplash';
+
+import type { RootStackScreenProps } from '../../../navigation/types';
+import { useBootStore } from '../../../stores/boot.store';
+import { useSessionStore } from '../../../stores/session.store';
+import { theme } from '../../../theme';
+import { SplashScreen } from '../SplashScreen';
+
+type Props = RootStackScreenProps<'Splash'>;
+
+const layout = {
+  nativeEvent: { layout: { x: 0, y: 0, width: 414, height: 736 } },
+};
+
+const renderSplash = async () => {
+  const navigation = { reset: jest.fn() };
+  await render(
+    <ThemeProvider theme={theme}>
+      <SplashScreen
+        navigation={navigation as unknown as Props['navigation']}
+        route={{ key: 'Splash-1', name: 'Splash' } as Props['route']}
+      />
+    </ThemeProvider>,
+  );
+  return navigation;
+};
+
+describe('SplashScreen', () => {
+  beforeEach(() => {
+    // O `scheduleOnRN` do mock dos worklets usa queueMicrotask.
+    jest.useFakeTimers({ doNotFake: ['queueMicrotask'] });
+    (BootSplash.hide as jest.Mock).mockClear();
+    useSessionStore.setState({ status: 'signedOut' });
+    useBootStore.setState({ splashDone: false });
+  });
+
+  afterEach(() => jest.useRealTimers());
+
+  it('desenha a raiz, o logo e o trilho com os rótulos de acessibilidade', async () => {
+    await renderSplash();
+
+    expect(screen.getByTestId('splash-screen')).toHaveProp(
+      'accessibilityLabel',
+      'FIAP School',
+    );
+    const logo = screen.getByTestId('splash-logo');
+    expect(logo).toHaveProp('accessibilityRole', 'image');
+    expect(logo).toHaveProp('accessibilityLabel', 'FIAP School');
+    // Um elemento só para o leitor: as camadas internas não aparecem.
+    expect(logo).toHaveProp('accessible', true);
+    const loading = screen.getByTestId('splash-loading', {
+      includeHiddenElements: true,
+    });
+    expect(loading).toHaveProp('accessibilityRole', 'progressbar');
+    expect(loading).toHaveProp('accessibilityLabel', 'Carregando');
+  });
+
+  it('o trilho só fica acessível a partir de 1500 ms, enquanto espera', async () => {
+    useSessionStore.setState({ status: 'loading' });
+    await renderSplash();
+
+    expect(screen.queryByTestId('splash-loading')).toBeNull();
+
+    await act(async () => {
+      await jest.advanceTimersByTimeAsync(1500);
+    });
+
+    expect(screen.getByTestId('splash-loading')).toBeOnTheScreen();
+  });
+
+  it('esconde a splash nativa sem fade no primeiro layout, uma vez só', async () => {
+    await renderSplash();
+    const root = screen.getByTestId('splash-screen');
+
+    await fireEvent(root, 'layout', layout);
+    await fireEvent(root, 'layout', layout);
+
+    expect(BootSplash.hide).toHaveBeenCalledTimes(1);
+    expect(BootSplash.hide).toHaveBeenCalledWith({ fade: false });
+  });
+
+  it('depois do mínimo faz a saída e troca para o Login', async () => {
+    const navigation = await renderSplash();
+    await fireEvent(screen.getByTestId('splash-screen'), 'layout', layout);
+
+    await act(async () => {
+      await jest.advanceTimersByTimeAsync(1200);
+    });
+
+    expect(navigation.reset).toHaveBeenCalledWith({
+      index: 0,
+      routes: [{ name: 'Login', params: { fromSplash: true } }],
+    });
+  });
+});
diff --git a/mobile/src/features/splash/__tests__/useBootErrorViewModel.test.tsx b/mobile/src/features/splash/__tests__/useBootErrorViewModel.test.tsx
new file mode 100644
index 0000000..8725b97
--- /dev/null
+++ b/mobile/src/features/splash/__tests__/useBootErrorViewModel.test.tsx
@@ -0,0 +1,156 @@
+import { act, renderHook, waitFor } from '@testing-library/react-native';
+import { http, HttpResponse } from 'msw';
+
+import { queryClient, queryKeys } from '../../../app/queryClient';
+import {
+  createSecureStorage,
+  secureStorage,
+} from '../../../services/storage/secureStorage';
+import { useSessionStore } from '../../../stores/session.store';
+import { API_URL, meResponse, meWithoutStudents } from '../../../test/fixtures';
+import { server } from '../../../test/msw/server';
+import { QueryWrapper } from '../../../test/queryWrapper';
+import { useBootErrorViewModel } from '../useBootErrorViewModel';
+
+describe('useBootErrorViewModel', () => {
+  const reset = jest.fn();
+
+  beforeEach(async () => {
+    reset.mockClear();
+    await useSessionStore.getState().signOut();
+    // O mesmo storage do client http: o request sai com este token.
+    await secureStorage.setToken('jwt-salvo');
+    useSessionStore.setState({ status: 'signedIn', signOutReason: null });
+    queryClient.clear();
+  });
+
+  const renderBootError = () =>
+    renderHook(() => useBootErrorViewModel({ reset }), {
+      wrapper: QueryWrapper,
+    });
+
+  it('TENTAR DE NOVO com aluno: refaz o /me, guarda no cache e vai às abas', async () => {
+    const { result } = await renderBootError();
+
+    await act(() => result.current.onRetry());
+
+    expect(reset).toHaveBeenCalledWith({
+      index: 0,
+      routes: [{ name: 'App', params: { screen: 'Agenda' } }],
+    });
+    expect(queryClient.getQueryData(queryKeys.me())).toEqual(meResponse);
+  });
+
+  it('TENTAR DE NOVO sem aluno vai para o NoStudent', async () => {
+    server.use(
+      http.get(`${API_URL}/me`, () => HttpResponse.json(meWithoutStudents)),
+    );
+    const { result } = await renderBootError();
+
+    await act(() => result.current.onRetry());
+
+    expect(reset).toHaveBeenCalledWith({
+      index: 0,
+      routes: [{ name: 'NoStudent' }],
+    });
+  });
+
+  it('fica carregando durante o request e ignora um 2º toque', async () => {
+    let calls = 0;
+    let respond: () => void = () => {};
+    server.use(
+      http.get(`${API_URL}/me`, async () => {
+        calls += 1;
+        await new Promise<void>(resolve => {
+          respond = resolve;
+        });
+        return HttpResponse.json(meResponse);
+      }),
+    );
+    const { result } = await renderBootError();
+
+    expect(result.current.retrying).toBe(false);
+    let first: Promise<void> = Promise.resolve();
+    await act(async () => {
+      first = result.current.onRetry();
+    });
+    expect(result.current.retrying).toBe(true);
+    await act(async () => {
+      result.current.onRetry();
+    });
+    await waitFor(() => expect(calls).toBe(1));
+
+    await act(async () => {
+      respond();
+      await first;
+    });
+    expect(calls).toBe(1);
+    expect(reset).toHaveBeenCalledTimes(1);
+  });
+
+  it('falhou de novo: fica na tela, para de carregar e dispara o shake', async () => {
+    server.use(http.get(`${API_URL}/me`, () => HttpResponse.error()));
+    const { result } = await renderBootError();
+    expect(result.current.shakeKey).toBe(0);
+
+    await act(() => result.current.onRetry());
+
+    expect(reset).not.toHaveBeenCalled();
+    expect(result.current.retrying).toBe(false);
+    expect(result.current.shakeKey).toBe(1);
+
+    await act(() => result.current.onRetry());
+    expect(result.current.shakeKey).toBe(2);
+  });
+
+  it('401 no retry: a sessão expira (o RootStack leva ao Login) e não navega daqui', async () => {
+    server.use(
+      http.get(`${API_URL}/me`, () =>
+        HttpResponse.json(
+          { statusCode: 401, message: 'Unauthorized' },
+          { status: 401 },
+        ),
+      ),
+    );
+    const { result } = await renderBootError();
+
+    await act(() => result.current.onRetry());
+
+    expect(reset).not.toHaveBeenCalled();
+    expect(useSessionStore.getState()).toMatchObject({
+      status: 'signedOut',
+      signOutReason: 'expired',
+    });
+  });
+
+  it('SAIR encerra a sessão mesmo offline', async () => {
+    server.use(http.get(`${API_URL}/me`, () => HttpResponse.error()));
+    const { result } = await renderBootError();
+
+    await act(() => result.current.onLogout());
+
+    expect(useSessionStore.getState().status).toBe('signedOut');
+    expect(await createSecureStorage().getToken()).toBeNull();
+  });
+
+  it('sair da tela no meio do retry cancela o request e não navega', async () => {
+    server.use(
+      http.get(`${API_URL}/me`, async () => {
+        await new Promise<void>(resolve => {
+          setTimeout(resolve, 50);
+        });
+        return HttpResponse.json(meResponse);
+      }),
+    );
+    const { result, unmount } = await renderBootError();
+
+    let pending: Promise<void> = Promise.resolve();
+    await act(async () => {
+      pending = result.current.onRetry();
+    });
+    await unmount();
+    await pending;
+
+    expect(reset).not.toHaveBeenCalled();
+  });
+});
diff --git a/mobile/src/features/splash/__tests__/useSplashAnimation.test.tsx b/mobile/src/features/splash/__tests__/useSplashAnimation.test.tsx
