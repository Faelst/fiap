+      }),
+    ).toHaveTextContent('-');
+    expect(
+      screen.getByTestId('boletim-term-1-subject-0-absences', {
+        includeHiddenElements: true,
+      }),
+    ).toHaveTextContent('-');
+    expect(
+      screen.getByTestId('boletim-term-1-subject-0-result'),
