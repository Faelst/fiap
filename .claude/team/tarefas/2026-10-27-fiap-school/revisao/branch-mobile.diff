+import { formatCpf } from '../utils/cpf';
+import { UnderlineInput, type UnderlineInputProps } from './UnderlineInput';
+
+/** Dígitos do CPF com a máscara `XXX.XXX.XXX-XX`. */
+const CPF_MASKED_LENGTH = 14;
+
+type CpfInputProps = Omit<
+  UnderlineInputProps,
+  'keyboardType' | 'maxLength' | 'textContentType' | 'autoComplete'
+>;
+
+/**
+ * `UnderlineInput` do CPF (01-design.md, 2.6): teclado numérico e máscara
+ * progressiva aplicada a cada mudança, inclusive ao colar só os dígitos.
+ */
+export function CpfInput({ onChangeText, ...props }: CpfInputProps) {
+  return (
+    <UnderlineInput
+      accessibilityHint="Somente números"
+      {...props}
+      onChangeText={text => onChangeText(formatCpf(text))}
+      keyboardType="number-pad"
+      maxLength={CPF_MASKED_LENGTH}
+      textContentType="username"
+      autoComplete="username"
+    />
+  );
+}
diff --git a/mobile/src/components/Dropdown.tsx b/mobile/src/components/Dropdown.tsx
new file mode 100644
index 0000000..5cebc11
--- /dev/null
+++ b/mobile/src/components/Dropdown.tsx
@@ -0,0 +1,277 @@
+import { useEffect, useRef, useState, type ComponentRef } from 'react';
+import {
+  AccessibilityInfo,
+  Modal,
+  Platform,
+  Pressable,
+  ScrollView,
+  StyleSheet,
+  useWindowDimensions,
+  View,
+} from 'react-native';
+import Animated, {
+  useAnimatedStyle,
+  useReducedMotion,
+  useSharedValue,
+  withTiming,
+} from 'react-native-reanimated';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+import { scheduleOnRN } from 'react-native-worklets';
+
+import { strings } from '../constants/strings';
+import { Box, Card, Text, useTheme, type Theme } from '../theme';
+import { ChevronDownIcon } from './icons/ChevronDownIcon';
+
+export type DropdownOption = { key: string; label: string };
+
+type DropdownProps = {
+  /** Texto do gatilho (a opção atual). */
+  label: string;
+  options: readonly DropdownOption[];
+  selectedKey: string | null;
+  onSelect: (key: string) => void;
+  /** Gatilho; os filhos são `-label`, `-options`, `-scroll`, `-option-<key>`, `-backdrop`, `-modal`. */
+  testID: string;
+  /** "Dia" ou "Turma e ano": o leitor lê "Dia: 17 de março, segunda-feira". */
+  accessibilityLabelPrefix: string;
+  accessibilityHint: string;
+  /** `l` na Agenda e `m` no Boletim, como no Figma. */
+  marginHorizontal: keyof Theme['spacing'];
+};
+
+type Anchor = { x: number; y: number; width: number; height: number };
+
+/**
+ * Dropdown da Agenda e do Boletim (01-design.md, 2.5 e 4.5). A lista abre num
+ * `Modal` transparente, por cima do conteúdo, na posição do gatilho medida
+ * por `measureInWindow` (sem briga de `zIndex` dentro da `ScrollView`). Abre
+ * abaixo do gatilho ou, sem espaço, acima, sempre dentro da área segura: o que
+ * não couber rola (tela baixa, fonte grande). Tocar fora ou o voltar do Android
+ * fecham sem mudar nada. A opção atual não tem marca visual (Figma), só o
+ * estado `selected` para o leitor de tela.
+ */
+export function Dropdown({
+  label,
+  options,
+  selectedKey,
+  onSelect,
+  testID,
+  accessibilityLabelPrefix,
+  accessibilityHint,
+  marginHorizontal,
+}: DropdownProps) {
+  const { colors, motion, sizes, spacing } = useTheme();
+  const window = useWindowDimensions();
+  const insets = useSafeAreaInsets();
+  const reducedMotion = useReducedMotion();
+  const triggerRef = useRef<ComponentRef<typeof View>>(null);
+  // Com âncora, o Modal está montado; `expanded` é o estado que o usuário vê.
+  const [anchor, setAnchor] = useState<Anchor | null>(null);
+  const [expanded, setExpanded] = useState(false);
+  // O foco volta ao gatilho só depois que o Modal sai (6.4): antes disso o
+  // gatilho está encoberto pelo modal e o leitor de tela não o alcança.
+  const focusPending = useRef(false);
+  const listProgress = useSharedValue(0);
+  const chevronProgress = useSharedValue(0);
+
+  const timing = (duration: number, easing: typeof motion.easeOut) => ({
+    duration: reducedMotion ? 0 : duration,
+    easing,
+  });
+
+  const open = () => {
+    triggerRef.current?.measureInWindow((x, y, width, height) => {
+      setAnchor({ x, y, width, height });
+      setExpanded(true);
+      listProgress.set(withTiming(1, timing(motion.fast, motion.easeOut)));
+      chevronProgress.set(withTiming(1, timing(motion.base, motion.easeOut)));
+    });
+  };
+
+  const focusTrigger = () => {
+    if (!focusPending.current) return;
+    focusPending.current = false;
+    if (triggerRef.current) {
+      AccessibilityInfo.sendAccessibilityEvent(triggerRef.current, 'focus');
+    }
+  };
+
+  const unmountList = () => {
+    focusPending.current = true;
+    setAnchor(null);
+  };
+
+  // iOS: o `onDismiss` do Modal avisa quando ele saiu. Android: o efeito roda
+  // depois do commit que tirou o Modal.
+  useEffect(() => {
+    if (anchor === null && Platform.OS !== 'ios') focusTrigger();
+  });
+
+  const close = () => {
+    setExpanded(false);
+    chevronProgress.set(withTiming(0, timing(motion.base, motion.easeOut)));
+    listProgress.set(
+      withTiming(0, timing(motion.exitFast, motion.easeIn), finished => {
+        'worklet';
+        // Fechada de novo no meio da saída (2º toque no fundo): a 1ª animação
+        // é interrompida e só a última desmonta a lista.
+        if (finished) scheduleOnRN(unmountList);
+      }),
+    );
+  };
+
+  const choose = (key: string) => {
+    if (!expanded) return;
+    onSelect(key);
+    close();
+  };
+
+  const listStyle = useAnimatedStyle(() => ({
+    opacity: listProgress.get(),
+    transform: [
+      {
+        translateY: (1 - listProgress.get()) * -motion.enterOffsetSmall,
+      },
+    ],
+  }));
+
+  const chevronStyle = useAnimatedStyle(() => ({
+    transform: [
+      { rotate: `${chevronProgress.get() * motion.chevronOpenDeg}deg` },
+    ],
+  }));
+
+  const listPosition = anchor
+    ? placeList(anchor, window.height, insets, {
+        gap: spacing.s,
+        estimatedHeight: options.length * sizes.touchTarget + 2 * spacing.xs,
+      })
+    : null;
+
+  return (
+    <>
+      <Pressable
+        ref={triggerRef}
+        testID={testID}
+        accessibilityRole="button"
+        accessibilityLabel={`${accessibilityLabelPrefix}: ${label}`}
+        accessibilityHint={accessibilityHint}
+        accessibilityState={{ expanded }}
+        onPress={expanded ? close : open}
+        style={({ pressed }) => ({
+          marginHorizontal: spacing[marginHorizontal],
+          opacity: pressed ? motion.pressedOpacity : 1,
+        })}
+      >
+        <Card variant="dropdown" gap="m">
+          <Box flex={1}>
+            <Text
+              testID={`${testID}-label`}
+              variant="body"
+              numberOfLines={1}
+              maxFontSizeMultiplier={sizes.fixedHeightFontScale}
+            >
+              {label}
+            </Text>
+          </Box>
+          <Animated.View style={chevronStyle}>
+            <ChevronDownIcon color={colors.primary} size={sizes.chevron} />
+          </Animated.View>
+        </Card>
+      </Pressable>
+      <Modal
+        testID={`${testID}-modal`}
+        visible={anchor !== null}
+        transparent
+        animationType="none"
+        statusBarTranslucent
+        navigationBarTranslucent
+        onRequestClose={close}
+        onDismiss={focusTrigger}
+      >
+        <Box style={StyleSheet.absoluteFill} accessibilityViewIsModal>
+          <Pressable
+            testID={`${testID}-backdrop`}
+            style={StyleSheet.absoluteFill}
+            accessibilityRole="button"
+            accessibilityLabel={strings.common.closeListAccessibilityLabel}
+            onPress={close}
+          />
+          {listPosition ? (
+            <Animated.View
+              testID={`${testID}-options`}
+              // Sumindo: nenhuma opção recebe um 2º toque.
+              pointerEvents={expanded ? 'auto' : 'none'}
+              style={[styles.list, listPosition, listStyle]}
+            >
+              <Card variant="options" flexShrink={1}>
+                <ScrollView
+                  testID={`${testID}-scroll`}
+                  style={{
+                    maxHeight: listPosition.maxHeight - 2 * spacing.xs,
+                  }}
+                  bounces={false}
+                >
+                  {options.map(option => (
+                    <Pressable
+                      key={option.key}
+                      testID={`${testID}-option-${option.key}`}
+                      accessibilityRole="button"
+                      accessibilityState={{
+                        selected: option.key === selectedKey,
+                      }}
+                      onPress={() => choose(option.key)}
+                      style={({ pressed }) => ({
+                        minHeight: sizes.touchTarget,
+                        paddingHorizontal: spacing.m,
+                        justifyContent: 'center',
+                        opacity: pressed ? motion.pressedOpacity : 1,
+                      })}
+                    >
+                      <Text
+                        variant="body"
+                        numberOfLines={1}
+                        maxFontSizeMultiplier={sizes.fixedHeightFontScale}
+                      >
+                        {option.label}
+                      </Text>
+                    </Pressable>
+                  ))}
+                </ScrollView>
+              </Card>
+            </Animated.View>
+          ) : null}
+        </Box>
+      </Modal>
+    </>
+  );
+}
+
+/**
+ * Lista `gap` abaixo do gatilho, com a mesma largura e o mesmo x, limitada à
+ * área segura. Abre abaixo se couber ali; senão, no lado com mais espaço. O
+ * `maxHeight` é o espaço desse lado: o que passar dele rola.
+ */
+function placeList(
+  anchor: Anchor,
+  windowHeight: number,
+  insets: { top: number; bottom: number },
+  { gap, estimatedHeight }: { gap: number; estimatedHeight: number },
+) {
+  const top = anchor.y + anchor.height + gap;
+  const spaceBelow = windowHeight - insets.bottom - top;
+  const spaceAbove = anchor.y - gap - insets.top;
+  const opensBelow = spaceBelow >= estimatedHeight || spaceBelow >= spaceAbove;
+  const horizontal = { left: anchor.x, width: anchor.width };
+  return opensBelow
+    ? { ...horizontal, top, maxHeight: spaceBelow }
+    : {
+        ...horizontal,
+        bottom: windowHeight - anchor.y + gap,
+        maxHeight: spaceAbove,
+      };
+}
+
+const styles = StyleSheet.create({
+  list: { position: 'absolute' },
+});
diff --git a/mobile/src/components/EmptyState.tsx b/mobile/src/components/EmptyState.tsx
new file mode 100644
index 0000000..5399623
--- /dev/null
+++ b/mobile/src/components/EmptyState.tsx
@@ -0,0 +1,127 @@
+import type { ReactNode } from 'react';
+import { Image, StyleSheet } from 'react-native';
+import Animated, {
+  FadeIn,
+  FadeInDown,
+  Keyframe,
+  ReduceMotion,
+  useReducedMotion,
+} from 'react-native-reanimated';
+
+import { Box, Text, useTheme, type Theme } from '../theme';
+
+const illustrationSource = require('../../assets/no-classroom.png');
+
+type EmptyStateProps = {
+  title: string;
+  description?: string;
+  illustration?: boolean;
+  action?: ReactNode;
+  testID: string;
+};
+
+type Motion = Theme['motion'];
+
+/**
+ * Entradas do estado vazio (01-design.md, 4.5 e 4.8). A ilustração cresce de
+ * 0,96 para 1 enquanto aparece, e o texto vem um stagger depois dela. Com
+ * reduzir movimento, tudo só aparece em fade: opacidade não é movimento, então
+ * o sistema não pode pular (`ReduceMotion.Never`).
+ */
+function entrances(motion: Motion, illustration: boolean, reduced: boolean) {
+  const first = illustration ? 1 : 0;
+  if (reduced) {
+    const fade = (delay: number) =>
+      FadeIn.duration(motion.base)
+        .delay(delay)
+        .reduceMotion(ReduceMotion.Never);
+    return {
+      illustration: fade(0),
+      text: (index: number) => fade((first + index) * motion.stagger),
+    };
+  }
+  return {
+    illustration: new Keyframe({
+      0: {
+        opacity: 0,
+        transform: [{ scale: motion.illustrationScaleFrom }],
+      },
+      100: { opacity: 1, transform: [{ scale: 1 }], easing: motion.easeOut },
+    })
+      .duration(motion.base)
+      .reduceMotion(ReduceMotion.System),
+    text: (index: number) =>
+      FadeInDown.duration(motion.base)
+        .delay((first + index) * motion.stagger)
+        .easing(motion.easeOut)
+        .withInitialValues({
+          transform: [{ translateY: motion.enterOffsetSmall }],
+        })
+        .reduceMotion(ReduceMotion.System),
+  };
+}
+
+/**
+ * Estado vazio (01-design.md, 2.10): ilustração do "sem aulas" cortada em
+ * 328 × 208 (os 82 px de baixo do PNG são o degradê), título e descrição.
+ * A ilustração é decorativa.
+ */
+export function EmptyState({
+  title,
+  description,
+  illustration = true,
+  action,
+  testID,
+}: EmptyStateProps) {
+  const { motion, sizes, spacing } = useTheme();
+  const reducedMotion = useReducedMotion();
+  const enter = entrances(motion, illustration, reducedMotion);
+
+  return (
+    <Box testID={testID} alignItems="center">
+      {illustration ? (
+        <Animated.View entering={enter.illustration}>
+          <Box
+            testID={`${testID}-illustration`}
+            accessible={false}
+            importantForAccessibility="no-hide-descendants"
+            overflow="hidden"
+            style={sizes.illustration}
+          >
+            <Image
+              source={illustrationSource}
+              style={styles.illustration}
+              resizeMode="cover"
+            />
+          </Box>
+        </Animated.View>
+      ) : null}
+      <Animated.View entering={enter.text(0)} style={{ marginTop: spacing.m }}>
+        <Text variant="emptyState">{title}</Text>
+      </Animated.View>
+      {description ? (
+        <Animated.View
+          entering={enter.text(1)}
+          style={{ marginTop: spacing.s, paddingHorizontal: spacing.huge }}
+        >
+          <Text variant="body" textAlign="center">
+            {description}
+          </Text>
+        </Animated.View>
+      ) : null}
+      {action ? (
+        <Animated.View
+          entering={enter.text(2)}
+          style={{ marginTop: spacing.l }}
+        >
+          {action}
+        </Animated.View>
+      ) : null}
+    </Box>
+  );
+}
+
+const styles = StyleSheet.create({
+  // PNG 328 × 290 alinhado ao topo; a caixa corta o degradê de baixo.
+  illustration: { width: '100%', aspectRatio: 328 / 290 },
+});
