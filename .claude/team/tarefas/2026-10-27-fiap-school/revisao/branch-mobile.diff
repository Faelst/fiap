@@ -0,0 +1,76 @@
+import { Pressable } from 'react-native';
+import Animated, {
+  useAnimatedStyle,
+  useSharedValue,
+  withSpring,
+  withTiming,
+} from 'react-native-reanimated';
+
+import { strings } from '../constants/strings';
+import { Card, Text, useTheme } from '../theme';
+
+const AnimatedCard = Animated.createAnimatedComponent(Card);
+
+type StudentCardProps = {
+  fullName: string;
+  rm: number;
+  className: string;
+  period: string;
+  selected: boolean;
+  onPress: () => void;
+  testID: string;
+};
+
+/**
+ * Card da seleção de aluno (01-design.md, 2.12). O selecionado tem borda
+ * `primary`, que acende com `fast` (4.7); o outro tem borda transparente da
+ * mesma largura, sem pulo de layout. Pressionado: escala 0,98.
+ */
+export function StudentCard({
+  fullName,
+  rm,
+  className,
+  period,
+  selected,
+  onPress,
+  testID,
+}: StudentCardProps) {
+  const { colors, motion } = useTheme();
+  const scale = useSharedValue(1);
+  const borderColor = selected ? colors.primary : colors.transparent;
+
+  const animatedStyle = useAnimatedStyle(() => ({
+    borderColor: withTiming(borderColor, { duration: motion.fast }),
+    transform: [{ scale: scale.get() }],
+  }));
+
+  return (
+    <Pressable
+      testID={testID}
+      accessibilityRole="button"
+      accessibilityLabel={strings.selectStudent.cardAccessibilityLabel(
+        fullName,
+        className,
+        rm,
+        period,
+      )}
+      accessibilityState={{ selected }}
+      onPress={onPress}
+      onPressIn={() => scale.set(withSpring(motion.pressScale, motion.press))}
+      onPressOut={() => scale.set(withSpring(1, motion.press))}
+    >
+      <AnimatedCard
+        testID={`${testID}-box`}
+        variant="student"
+        style={animatedStyle}
+      >
+        <Text variant="bodyMedium" textTransform="uppercase" numberOfLines={1}>
+          {fullName}
+        </Text>
+        <Text variant="body">
+          {strings.selectStudent.studentInfo(className, rm, period)}
+        </Text>
+      </AnimatedCard>
+    </Pressable>
+  );
+}
diff --git a/mobile/src/components/TabBar.tsx b/mobile/src/components/TabBar.tsx
new file mode 100644
index 0000000..957c3b9
--- /dev/null
+++ b/mobile/src/components/TabBar.tsx
@@ -0,0 +1,179 @@
+import type { BottomTabBarProps } from '@react-navigation/bottom-tabs';
+import { useEffect, useRef, type ReactNode } from 'react';
+import { Pressable, StyleSheet } from 'react-native';
+import Animated, {
+  Easing,
+  useAnimatedStyle,
+  useReducedMotion,
+  useSharedValue,
+  withSequence,
+  withTiming,
+} from 'react-native-reanimated';
+
+import { Box, Text, useTheme } from '../theme';
+
+type TabItemProps = {
+  label: string;
+  accessibilityLabel?: string;
+  testID?: string;
+  focused: boolean;
+  renderIcon: (color: string) => ReactNode;
+  onPress: () => void;
+};
+
+/**
+ * Um item da tab bar. Ícone e rótulo existem em duas camadas sobrepostas
+ * (`text` e `primary`) e a ativa aparece por crossfade de opacidade (4.4):
+ * assim não se anima a cor do SVG, que não roda na UI thread. O ícone que
+ * acabou de ficar ativo faz 1 → 1,12 → 1.
+ */
+function TabItem({
+  label,
+  accessibilityLabel,
+  testID,
+  focused,
+  renderIcon,
+  onPress,
+}: TabItemProps) {
+  const { colors, motion, sizes } = useTheme();
+  const reducedMotion = useReducedMotion();
+  const active = useSharedValue(focused ? 1 : 0);
+  const iconScale = useSharedValue(1);
+  const wasFocused = useRef(focused);
+
+  useEffect(() => {
+    const target = focused ? 1 : 0;
+    if (reducedMotion) {
+      active.set(target);
+    } else {
+      active.set(
+        withTiming(target, { duration: motion.base, easing: motion.easeOut }),
+      );
+      if (focused && !wasFocused.current) {
+        iconScale.set(
+          withSequence(
+            withTiming(motion.tabIconPop, {
+              duration: motion.fast,
+              easing: Easing.out(Easing.cubic),
+            }),
+            withTiming(1, { duration: motion.fast }),
+          ),
+        );
+      }
+    }
+    wasFocused.current = focused;
+  }, [focused, reducedMotion, active, iconScale, motion]);
+
+  const activeLayer = useAnimatedStyle(() => ({ opacity: active.get() }));
+  const inactiveLayer = useAnimatedStyle(() => ({
+    opacity: 1 - active.get(),
+  }));
+  const iconStyle = useAnimatedStyle(() => ({
+    transform: [{ scale: iconScale.get() }],
+  }));
+
+  const layer = (color: string, colorName: 'text' | 'primary') => (
+    <Box alignItems="center" gap="xs">
+      <Box height={sizes.icon} justifyContent="center">
+        {renderIcon(color)}
+      </Box>
+      <Text
+        variant="tabLabel"
+        color={colorName}
+        maxFontSizeMultiplier={sizes.fixedHeightFontScale}
+      >
+        {label}
+      </Text>
+    </Box>
+  );
+
+  return (
+    <Pressable
+      testID={testID}
+      accessibilityRole="tab"
+      accessibilityLabel={accessibilityLabel}
+      accessibilityState={{ selected: focused }}
+      onPress={onPress}
+      style={styles.item}
+    >
+      <Box paddingTop="sm" alignItems="center">
+        <Animated.View style={iconStyle}>
+          <Animated.View style={inactiveLayer}>
+            {layer(colors.text, 'text')}
+          </Animated.View>
+          <Animated.View
+            testID={testID ? `${testID}-active-layer` : undefined}
+            style={[StyleSheet.absoluteFill, activeLayer]}
+          >
+            {layer(colors.primary, 'primary')}
+          </Animated.View>
+        </Animated.View>
+      </Box>
+    </Pressable>
+  );
+}
+
+/**
+ * Tab bar do Figma (01-design.md, 2.4): fundo `surface`, altura
+ * `sizes.tabBar` + inset de baixo, duas colunas iguais; aba ativa em
+ * `primary`. Ícone e rótulo vêm das options de cada aba.
+ */
+export function TabBar({
+  state,
+  descriptors,
+  navigation,
+  insets,
+}: BottomTabBarProps) {
+  const { sizes } = useTheme();
+
+  return (
+    <Box
+      testID="tab-bar"
+      accessibilityRole="tablist"
+      flexDirection="row"
+      backgroundColor="surface"
+      style={{
+        height: sizes.tabBar + insets.bottom,
+        paddingBottom: insets.bottom,
+      }}
+    >
+      {state.routes.map((route, index) => {
+        const { options } = descriptors[route.key];
+        const focused = state.index === index;
+        const label =
+          typeof options.tabBarLabel === 'string'
+            ? options.tabBarLabel
+            : options.title ?? route.name;
+
+        const onPress = () => {
+          const event = navigation.emit({
+            type: 'tabPress',
+            target: route.key,
+            canPreventDefault: true,
+          });
+          if (!focused && !event.defaultPrevented) {
+            navigation.navigate(route.name, route.params);
+          }
+        };
+
+        return (
+          <TabItem
+            key={route.key}
+            label={label}
+            accessibilityLabel={options.tabBarAccessibilityLabel}
+            testID={options.tabBarButtonTestID}
+            focused={focused}
+            onPress={onPress}
+            renderIcon={color =>
+              options.tabBarIcon?.({ focused, color, size: sizes.icon })
+            }
+          />
+        );
+      })}
+    </Box>
+  );
+}
+
+const styles = StyleSheet.create({
+  item: { flex: 1 },
+});
diff --git a/mobile/src/components/UnderlineInput.tsx b/mobile/src/components/UnderlineInput.tsx
new file mode 100644
index 0000000..e47e124
--- /dev/null
+++ b/mobile/src/components/UnderlineInput.tsx
@@ -0,0 +1,115 @@
+import {
+  createRestyleComponent,
+  createVariant,
+  spacing as spacingRestyle,
+  type SpacingProps,
+  type VariantProps,
+} from '@shopify/restyle';
+import { useState, type Ref } from 'react';
+import {
+  TextInput,
+  type TextInputInstance,
+  type TextInputProps,
+} from 'react-native';
+import Animated, {
+  useAnimatedStyle,
+  withTiming,
+} from 'react-native-reanimated';
+
+import { Box, Text, useTheme, type Theme } from '../theme';
+
+/** TextInput com as `textVariants` e o espaçamento do tema. */
+const ThemedTextInput = createRestyleComponent<
+  VariantProps<Theme, 'textVariants'> &
+    SpacingProps<Theme> &
+    TextInputProps & { ref?: Ref<TextInputInstance> },
+  Theme
+>([createVariant({ themeKey: 'textVariants' }), ...spacingRestyle], TextInput);
+
+export type UnderlineInputProps = Pick<
+  TextInputProps,
+  | 'value'
+  | 'onBlur'
+  | 'onFocus'
+  | 'secureTextEntry'
+  | 'keyboardType'
+  | 'textContentType'
+  | 'autoComplete'
+  | 'returnKeyType'
+  | 'onSubmitEditing'
+  | 'submitBehavior'
+  | 'editable'
+  | 'maxLength'
+  | 'accessibilityHint'
+> & {
+  label: string;
+  onChangeText: (text: string) => void;
+  testID: string;
+  /** Rótulo lido pelo leitor de tela (padrão: o próprio `label`). */
+  accessibilityLabel?: string;
+  inputRef?: Ref<TextInputInstance>;
+};
+
+/**
+ * Campo do login (01-design.md, 2.6): rótulo centralizado, valor grande e uma
+ * linha embaixo. O rótulo fica em negrito com o foco; a linha passa de
+ * `inputLine` para `text` quando há valor.
+ */
+export function UnderlineInput({
+  label,
+  value,
+  onChangeText,
+  onBlur,
+  onFocus,
+  testID,
+  accessibilityLabel,
+  inputRef,
+  ...inputProps
+}: UnderlineInputProps) {
+  const { colors, motion, sizes, spacing } = useTheme();
+  const [focused, setFocused] = useState(false);
+  const lineColor = value ? colors.text : colors.inputLine;
+
+  const lineStyle = useAnimatedStyle(() => ({
+    backgroundColor: withTiming(lineColor, { duration: motion.fast }),
+  }));
+
+  return (
+    <Box width="100%">
+      <Text
+        variant={focused ? 'labelFocused' : 'label'}
+        importantForAccessibility="no"
+        accessibilityElementsHidden
+      >
+        {label}
+      </Text>
+      <ThemedTextInput
+        ref={inputRef}
+        testID={testID}
+        variant="inputValue"
+        marginTop="l"
+        padding="none"
+        value={value}
+        onChangeText={onChangeText}
+        onFocus={event => {
+          setFocused(true);
+          onFocus?.(event);
+        }}
+        onBlur={event => {
+          setFocused(false);
+          onBlur?.(event);
+        }}
+        accessibilityLabel={accessibilityLabel ?? label}
+        selectionColor={colors.primary}
+        cursorColor={colors.primary}
+        autoCorrect={false}
+        autoCapitalize="none"
+        {...inputProps}
+      />
+      <Animated.View
+        testID={`${testID}-line`}
+        style={[{ height: sizes.inputLine, marginTop: spacing.s }, lineStyle]}
+      />
+    </Box>
+  );
+}
diff --git a/mobile/src/components/__tests__/Accordion.test.tsx b/mobile/src/components/__tests__/Accordion.test.tsx
new file mode 100644
index 0000000..c84be13
