+
+  it('quando a sessão acaba (logout ou 401) volta ao Login, sem passar pela splash', async () => {
+    await createSecureStorage().setToken('jwt-salvo');
+    await render(<App />);
+    expect(
+      await screen.findByTestId('agenda-screen', {}, AFTER_SPLASH),
+    ).toBeOnTheScreen();
