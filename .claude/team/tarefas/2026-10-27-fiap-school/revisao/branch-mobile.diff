+    expect(result.current.selectedYearKey).toBe('2025');
+  });
+
+  it('mapeia os trimestres e as disciplinas para exibição, todos fechados', async () => {
+    const { result } = await renderReady();
+
+    expect(result.current.terms).toHaveLength(3);
