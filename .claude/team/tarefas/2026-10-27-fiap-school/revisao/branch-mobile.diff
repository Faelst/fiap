+  it('login de responsável sem aluno abre o NoStudent, não as abas', async () => {
+    server.use(
+      http.post(`${API_URL}/auth/login`, () =>
+        HttpResponse.json({
+          accessToken: 'jwt-carlos',
+          guardian: { id: 'g9', firstName: 'Carlos', lastName: 'Sem Aluno' },
+        }),
