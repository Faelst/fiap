diff --git a/mobile/jest.setup.ts b/mobile/jest.setup.ts
new file mode 100644
index 0000000..abe550f
--- /dev/null
+++ b/mobile/jest.setup.ts
@@ -0,0 +1,73 @@
+/* eslint-env jest */
+
+jest.mock('react-native-worklets', () =>
+  require('react-native-worklets/src/mock'),
+);
+
+jest.mock('react-native-reanimated', () =>
+  require('react-native-reanimated/mock'),
+);
+
+jest.mock(
+  'react-native-safe-area-context',
+  () => require('react-native-safe-area-context/jest/mock').default,
+);
+
+jest.mock('react-native-bootsplash', () => ({
+  hide: jest.fn().mockResolvedValue(undefined),
+  isVisible: jest.fn().mockReturnValue(false),
+  useHideAnimation: jest.fn().mockReturnValue({ container: {}, logo: {} }),
+}));
+
+jest.mock('react-native-keychain', () =>
+  require('./jest/mocks/react-native-keychain'),
+);
+
+// O react-native-mmkv usa um mock em memória quando roda no Jest, mas importa o
+// Nitro, que procura o módulo nativo ao carregar.
+jest.mock('react-native-nitro-modules', () => ({
+  NitroModules: {
+    createHybridObject: jest.fn(() => {
+      throw new Error('Nitro não existe no Jest');
+    }),
+  },
+}));
+
+jest.mock('react-native-config', () => ({
+  __esModule: true,
+  default: { API_URL: 'http://localhost:3333/api' },
+  Config: { API_URL: 'http://localhost:3333/api' },
+}));
+
+// O logger do app não escreve no console nos testes: a saída do CI fica só com
+// o que importa (falhas e avisos do React). Nível, redação e chamadas
+// continuam valendo; quem testa o log usa `jest.spyOn(logger, ...)`, e o
+// transporte de console tem teste próprio (`requireActual`).
+jest.mock('./src/services/logger/transports', () => ({
+  consoleTransport: jest.fn(),
+}));
+
+beforeEach(() => {
+  require('./jest/mocks/react-native-keychain').__reset();
+});
+
+// API falsa (MSW) para services e hooks. Request sem handler falha o teste.
+const { server } = require('./src/test/msw/server');
+
+beforeAll(() => server.listen({ onUnhandledRequest: 'error' }));
+afterEach(() => server.resetHandlers());
+afterAll(() => server.close());
+
+// O app usa um QueryClient único. Com o gcTime padrão (5 min), toda query ou
+// mutation que fica sem observador agenda um setTimeout, e o `clear()` do
+// MutationCache não cancela esse timer: o worker do Jest não terminava
+// ("failed to exit gracefully"). Com gcTime infinito nenhum timer de GC é
+// criado (recomendação do TanStack para testes); o cache é limpo por arquivo.
+const { queryClient } = require('./src/app/queryClient');
+const appDefaults = queryClient.getDefaultOptions();
+queryClient.setDefaultOptions({
+  ...appDefaults,
+  queries: { ...appDefaults.queries, gcTime: Infinity },
+  mutations: { ...appDefaults.mutations, gcTime: Infinity },
+});
+afterAll(() => queryClient.clear());
diff --git a/mobile/jest/mocks/react-native-keychain.ts b/mobile/jest/mocks/react-native-keychain.ts
new file mode 100644
index 0000000..1727353
--- /dev/null
+++ b/mobile/jest/mocks/react-native-keychain.ts
@@ -0,0 +1,39 @@
+/** Keychain em memória para os testes (mesma forma da API do react-native-keychain). */
+const store = new Map<string, { username: string; password: string }>();
+
+const DEFAULT_SERVICE = 'default';
+
+export const ACCESSIBLE = {
+  WHEN_UNLOCKED: 'AccessibleWhenUnlocked',
+  AFTER_FIRST_UNLOCK: 'AccessibleAfterFirstUnlock',
+  WHEN_UNLOCKED_THIS_DEVICE_ONLY: 'AccessibleWhenUnlockedThisDeviceOnly',
+  AFTER_FIRST_UNLOCK_THIS_DEVICE_ONLY:
+    'AccessibleAfterFirstUnlockThisDeviceOnly',
+};
+
+export const setGenericPassword = jest.fn(
+  async (
+    username: string,
+    password: string,
+    options?: { service?: string },
+  ) => {
+    const service = options?.service ?? DEFAULT_SERVICE;
+    store.set(service, { username, password });
+    return { service, storage: 'keychain' };
+  },
+);
+
+export const getGenericPassword = jest.fn(
+  async (options?: { service?: string }) => {
+    const entry = store.get(options?.service ?? DEFAULT_SERVICE);
+    return entry ? { ...entry, service: options?.service } : false;
+  },
+);
+
+export const resetGenericPassword = jest.fn(
+  async (options?: { service?: string }) =>
+    store.delete(options?.service ?? DEFAULT_SERVICE),
+);
+
+/** Só para os testes: zera o keychain falso. */
+export const __reset = () => store.clear();
diff --git a/mobile/jest/resolver.js b/mobile/jest/resolver.js
new file mode 100644
index 0000000..9ed1baa
--- /dev/null
+++ b/mobile/jest/resolver.js
@@ -0,0 +1,14 @@
+/**
+ * Encadeia o resolver do preset do RN (libera subpaths de `react-native`) com o
+ * do reanimated/worklets (que tira as extensões `.native` de alguns módulos no
+ * Jest, senão o reanimated tenta iniciar o módulo nativo).
+ */
+const rnResolver = require('@react-native/jest-preset/jest/resolver');
+const reanimatedResolver = require('react-native-reanimated/jest/resolver');
+
+module.exports = (request, options) =>
+  reanimatedResolver(request, {
+    ...options,
+    defaultResolver: (req, opts) =>
+      rnResolver(req, { ...opts, defaultResolver: options.defaultResolver }),
+  });
