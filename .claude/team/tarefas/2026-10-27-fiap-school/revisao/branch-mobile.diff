@@ -0,0 +1,49 @@
+import axios from 'axios';
+import { Platform } from 'react-native';
+import Config from 'react-native-config';
+
+import { useSessionStore } from '../../stores/session.store';
+import { logger } from '../logger';
+import { secureStorage } from '../storage/secureStorage';
+import { resolveApiUrl } from './apiUrl';
+import { attachInterceptors } from './interceptors';
+
+const TIMEOUT_MS = 15_000;
+
+export const http = axios.create({
+  baseURL: resolveApiUrl(Config.API_URL, Platform.OS),
+  timeout: TIMEOUT_MS,
+  headers: { Accept: 'application/json' },
+});
+
+/** Um 401 por vez encerra a sessão; os outros esperam o mesmo signOut. */
+let expiringSession: Promise<void> | null = null;
+
+/**
+ * Só encerra a sessão se o 401 veio do token em uso agora. Um 401 atrasado
+ * de um request da sessão anterior (o usuário já entrou de novo) é ignorado.
+ */
+async function expireSession(requestToken: string | null): Promise<void> {
+  const currentToken = await secureStorage.getToken();
+  const { status, signOut } = useSessionStore.getState();
+  if (
+    status !== 'signedIn' ||
+    requestToken === null ||
+    requestToken !== currentToken
+  ) {
+    return expiringSession ?? undefined;
+  }
+  if (!expiringSession) {
+    logger.info('sessão expirada: voltando ao login');
+    expiringSession = signOut('expired').finally(() => {
+      expiringSession = null;
+    });
+  }
+  return expiringSession;
+}
+
+attachInterceptors(http, {
+  getToken: secureStorage.getToken,
+  onUnauthorized: expireSession,
+  logger,
+});
diff --git a/mobile/src/services/http/errors.ts b/mobile/src/services/http/errors.ts
new file mode 100644
index 0000000..71f40e6
--- /dev/null
+++ b/mobile/src/services/http/errors.ts
@@ -0,0 +1,130 @@
+import { isAxiosError, isCancel } from 'axios';
+import { z, ZodError } from 'zod';
+
+export type ApiErrorKind =
+  | 'badRequest'
+  | 'unauthorized'
+  | 'forbidden'
+  | 'notFound'
+  | 'rateLimited'
+  | 'server'
+  | 'network'
+  | 'invalidResponse'
+  /** Request abortado pelo `signal` (troca de aluno, logout). Não é falha. */
+  | 'canceled'
+  /** Falha do aparelho (keychain/Keystore), não da API. */
+  | 'storage'
+  | 'unknown';
+
+type ApiErrorOptions = {
+  status?: number;
+  /** Mensagem que veio da API (`message` do Nest). */
+  apiMessage?: string;
+  /** Mensagem do próprio app, quando o erro não vem da API. */
+  message?: string;
+  cause?: unknown;
+};
+
+/**
+ * Erro único da camada HTTP. Os ViewModels decidem o texto da tela pelo
+ * `kind`, sem conhecer axios nem zod.
+ */
+export class ApiError extends Error {
+  readonly kind: ApiErrorKind;
+  readonly status?: number;
+  readonly apiMessage?: string;
+
+  constructor(kind: ApiErrorKind, options: ApiErrorOptions = {}) {
+    super(options.apiMessage ?? options.message ?? kind, {
+      cause: options.cause,
+    });
+    this.name = 'ApiError';
+    // O Hermes pode ignorar o 2º argumento do Error; garante a causa.
+    if (options.cause !== undefined && this.cause === undefined) {
+      this.cause = options.cause;
+    }
+    this.kind = kind;
+    this.status = options.status;
+    this.apiMessage = options.apiMessage;
+  }
+}
+
+function kindFromStatus(status: number): ApiErrorKind {
+  if (status === 400) return 'badRequest';
+  if (status === 401) return 'unauthorized';
+  if (status === 403) return 'forbidden';
+  if (status === 404) return 'notFound';
+  if (status === 429) return 'rateLimited';
+  if (status >= 500) return 'server';
+  return 'unknown';
+}
+
+/**
+ * Corpo de erro do Nest: `{statusCode, message, error}`. O `message` é string
+ * (regra de negócio) ou lista (ValidationPipe); a UI recebe uma só, a primeira.
+ */
+export const apiErrorBodySchema = z.object({
+  statusCode: z.number().optional(),
+  message: z.union([z.string(), z.array(z.string())]),
+  error: z.string().optional(),
+});
+
+function messageFrom(data: unknown): string | undefined {
+  const parsed = apiErrorBodySchema.safeParse(data);
+  if (!parsed.success) return undefined;
+  const { message } = parsed.data;
+  return typeof message === 'string' ? message : message[0];
+}
+
+/** Causa de um erro HTTP sem nada que identifique o usuário. */
+export type HttpErrorCause = {
+  name: string;
+  code?: string;
+  status?: number;
+  method?: string;
+  url?: string;
+};
+
+/**
+ * O AxiosError carrega `config.data` (CPF e senha do login), `config.headers`
+ * (Bearer) e `response.data`. Na `cause` fica só o que ajuda a depurar, para o
+ * erro poder ser serializado (React Query, Reactotron) sem vazar dado.
+ */
+function httpCause(error: {
+  name: string;
+  code?: string;
+  config?: { method?: string; url?: string };
+  response?: { status: number };
+}): HttpErrorCause {
+  return {
+    name: error.name,
+    code: error.code,
+    status: error.response?.status,
+    method: error.config?.method?.toUpperCase(),
+    url: error.config?.url?.split('?')[0],
+  };
+}
+
+export function toApiError(error: unknown): ApiError {
+  if (error instanceof ApiError) {
+    return error;
+  }
+  if (error instanceof ZodError) {
+    return new ApiError('invalidResponse', { cause: error });
+  }
+  if (isCancel(error)) {
+    return new ApiError('canceled', { cause: httpCause(error) });
+  }
+  if (isAxiosError(error)) {
+    if (!error.response) {
+      return new ApiError('network', { cause: httpCause(error) });
+    }
+    const { status, data } = error.response;
+    return new ApiError(kindFromStatus(status), {
+      status,
+      apiMessage: messageFrom(data),
+      cause: httpCause(error),
+    });
+  }
+  return new ApiError('unknown', { cause: error });
+}
diff --git a/mobile/src/services/http/interceptors.ts b/mobile/src/services/http/interceptors.ts
new file mode 100644
index 0000000..39f6d93
--- /dev/null
+++ b/mobile/src/services/http/interceptors.ts
@@ -0,0 +1,110 @@
+import type {
+  AxiosError,
+  AxiosInstance,
+  AxiosResponse,
+  InternalAxiosRequestConfig,
+} from 'axios';
+
+import type { LogLevel, Logger } from '../logger';
+import { type ApiErrorKind, toApiError } from './errors';
+
+/** Rotas sem token, em que 401 é resposta de negócio (credencial errada). */
+export const PUBLIC_PATHS = new Set(['/auth/login']);
+
+type InterceptorDeps = {
+  getToken: () => Promise<string | null>;
+  /**
+   * Chamado em 401 de rota protegida, com o token com que o request saiu
+   * (`null` se saiu sem token). Quem decide se a sessão atual acabou é ele.
+   */
+  onUnauthorized: (requestToken: string | null) => Promise<void> | void;
+  logger: Logger;
+  now?: () => number;
+};
+
+/**
+ * Nível do log de erro. Resposta esperada da API (credencial errada, sem
+ * acesso, ano inexistente) não é `warn`: em dev o `console.warn` abre o toast
+ * do LogBox em cima do botão da tela.
+ */
+const ERROR_LOG_LEVEL: Record<ApiErrorKind, LogLevel> = {
+  badRequest: 'info',
+  unauthorized: 'info',
+  forbidden: 'info',
+  notFound: 'info',
+  rateLimited: 'info',
+  canceled: 'debug',
+  server: 'warn',
+  network: 'warn',
+  invalidResponse: 'warn',
+  storage: 'warn',
+  unknown: 'warn',
+};
+
+type RequestMeta = { startedAt: number; token: string | null };
+
+const requestMeta = new WeakMap<InternalAxiosRequestConfig, RequestMeta>();
+
+const isPublic = (config?: InternalAxiosRequestConfig) =>
+  PUBLIC_PATHS.has(config?.url ?? '');
+
+export function attachInterceptors(
+  instance: AxiosInstance,
+  { getToken, onUnauthorized, logger, now = Date.now }: InterceptorDeps,
+) {
+  const describe = (config: InternalAxiosRequestConfig | undefined) => {
+    const method = (config?.method ?? 'get').toUpperCase();
+    const url = config?.url ?? '';
+    const meta = config ? requestMeta.get(config) : undefined;
+    return {
+      method,
+      url,
+      durationMs: meta === undefined ? undefined : now() - meta.startedAt,
+    };
+  };
+
+  instance.interceptors.request.use(async config => {
+    // Um Authorization explícito (o token recém-emitido no login, antes de a
+    // sessão abrir) vale mais que o da memória e não é da sessão atual: um
+    // 401 dele não encerra a sessão.
+    const explicit = config.headers.has('Authorization');
+    const token = isPublic(config) || explicit ? null : await getToken();
+    requestMeta.set(config, { startedAt: now(), token });
+    if (token) {
+      config.headers.set('Authorization', `Bearer ${token}`);
+    }
+    return config;
+  });
+
+  instance.interceptors.response.use(
+    (response: AxiosResponse) => {
+      const request = describe(response.config);
+      logger.info(`http ${request.method} ${request.url} ${response.status}`, {
+        ...request,
+        status: response.status,
+        requestId: response.headers['x-request-id'],
+      });
+      return response;
+    },
+    async (error: AxiosError) => {
+      const apiError = toApiError(error);
+      const request = describe(error.config);
+      const status = apiError.status ?? 'sem resposta';
+      logger[ERROR_LOG_LEVEL[apiError.kind]](
+        `http ${request.method} ${request.url} ${status}`,
+        {
+          ...request,
+          status: apiError.status,
+          kind: apiError.kind,
+          requestId: error.response?.headers?.['x-request-id'],
+        },
+      );
+
+      if (apiError.kind === 'unauthorized' && !isPublic(error.config)) {
+        const meta = error.config ? requestMeta.get(error.config) : undefined;
+        await onUnauthorized(meta?.token ?? null);
+      }
+      throw apiError;
+    },
+  );
+}
diff --git a/mobile/src/services/http/parseResponse.ts b/mobile/src/services/http/parseResponse.ts
new file mode 100644
index 0000000..379f920
--- /dev/null
+++ b/mobile/src/services/http/parseResponse.ts
@@ -0,0 +1,28 @@
+import type { z } from 'zod';
+
+import { logger } from '../logger';
+import { ApiError } from './errors';
+
+/**
+ * Valida a resposta contra o schema do contrato. Fora do contrato vira
+ * `ApiError('invalidResponse')` (a tela mostra o estado de erro) e o log
+ * registra só o caminho e o código de cada problema, nunca o valor recebido.
+ */
+export function parseResponse<S extends z.ZodType>(
+  schema: S,
+  data: unknown,
+  endpoint: string,
+): z.infer<S> {
+  const result = schema.safeParse(data);
+  if (result.success) {
+    return result.data;
+  }
+  logger.error('resposta fora do contrato', {
+    endpoint,
+    issues: result.error.issues.map(issue => ({
+      path: issue.path.join('.'),
+      code: issue.code,
+    })),
+  });
+  throw new ApiError('invalidResponse', { cause: result.error });
+}
