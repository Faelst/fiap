+describe('weekdayName', () => {
+  it('nomeia os dias em pt-BR minúsculo', () => {
+    expect([0, 1, 2, 3, 4, 5, 6].map(weekdayName)).toEqual([
+      'domingo',
+      'segunda-feira',
+      'terça-feira',
+      'quarta-feira',
+      'quinta-feira',
+      'sexta-feira',
+      'sábado',
+    ]);
+  });
