+import type { LogTransport } from './logger';
+
+/**
+ * Liga o Reactotron em dev e devolve um transporte para o logger. Os plugins
+ * de rede, de console e de AsyncStorage ficam desligados: o de rede mostraria
+ * o header Authorization e o corpo do login sem redação. Os requests aparecem
+ * pelo log do interceptor (já redigido).
+ *
+ * No emulador Android rode `adb reverse tcp:9090 tcp:9090`.
+ */
+export function connectReactotron(): LogTransport {
+  const Reactotron = require('reactotron-react-native').default;
+
+  Reactotron.configure({ name: 'FIAP School' })
+    .useReactNative({ networking: false, log: false, asyncStorage: false })
+    .connect();
+
+  return ({ level, message, context }) => {
+    Reactotron.display({
+      name: level.toUpperCase(),
+      preview: message,
+      value: context ?? message,
+      important: level === 'warn' || level === 'error',
+    });
+  };
+}
diff --git a/mobile/src/services/logger/redact.ts b/mobile/src/services/logger/redact.ts
new file mode 100644
index 0000000..b06ed47
--- /dev/null
+++ b/mobile/src/services/logger/redact.ts
@@ -0,0 +1,42 @@
+export const REDACTED = '[REDACTED]';
+
+/** Chaves que nunca saem no log (comparação sem maiúsculas). */
+const SENSITIVE_KEYS = new Set([
+  'authorization',
+  'password',
+  'cpf',
+  'accesstoken',
+]);
+
+function redactValue(value: unknown, seen: WeakSet<object>): unknown {
+  if (value === null || typeof value !== 'object') {
+    return value;
+  }
+  if (seen.has(value)) {
+    return '[Circular]';
+  }
+  seen.add(value);
+
+  // Erro vira só nome e mensagem: um AxiosError carrega `config.headers`
+  // (token) e `config.data` (corpo do login em texto), que a redação por
+  // chave não alcança.
+  if (value instanceof Error) {
+    return { name: value.name, message: value.message };
+  }
+  if (Array.isArray(value)) {
+    return value.map(item => redactValue(item, seen));
+  }
+
+  const result: Record<string, unknown> = {};
+  for (const [key, item] of Object.entries(value)) {
+    result[key] = SENSITIVE_KEYS.has(key.toLowerCase())
+      ? REDACTED
+      : redactValue(item, seen);
+  }
+  return result;
+}
+
+/** Cópia do valor com token, senha e CPF trocados por `[REDACTED]`. */
+export function redact<T>(value: T): T {
+  return redactValue(value, new WeakSet()) as T;
+}
