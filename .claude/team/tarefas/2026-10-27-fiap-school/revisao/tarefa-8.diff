+import { createMMKV } from 'react-native-mmkv';
+import type { StateStorage } from 'zustand/middleware';
+
+/**
+ * Armazenamento rápido e não criptografado, para preferência de tela
+ * (aluno selecionado). Token e dado pessoal não entram aqui.
+ */
+export const mmkv = createMMKV({ id: 'fiap-school' });
+
+/** Adaptador do mmkv para o `persist` do zustand. */
+export const mmkvStateStorage: StateStorage = {
+  getItem: name => mmkv.getString(name) ?? null,
+  setItem: (name, value) => mmkv.set(name, value),
+  removeItem: name => {
+    mmkv.remove(name);
+  },
+};
diff --git a/mobile/src/services/storage/secureStorage.ts b/mobile/src/services/storage/secureStorage.ts
new file mode 100644
index 0000000..27e7d86
--- /dev/null
+++ b/mobile/src/services/storage/secureStorage.ts
@@ -0,0 +1,63 @@
+import * as Keychain from 'react-native-keychain';
+
+import { logger } from '../logger';
+
+const SERVICE = 'br.com.fiap.school.session';
+const USERNAME = 'session';
+
+export type SecureStorage = {
+  /** Lê o keychain e atualiza a memória (abertura do app). */
+  loadToken: () => Promise<string | null>;
+  /** Token da memória; vai ao keychain só na primeira vez. */
+  getToken: () => Promise<string | null>;
+  setToken: (token: string) => Promise<void>;
+  clearToken: () => Promise<void>;
+};
+
+/**
+ * O JWT mora só no Keychain (iOS) / Keystore (Android). A cópia em memória
+ * evita uma ida ao keychain por request e some quando o app fecha.
+ */
+export function createSecureStorage(): SecureStorage {
+  let cached: string | null | undefined;
+
+  const loadToken = async () => {
+    try {
+      const credentials = await Keychain.getGenericPassword({
+        service: SERVICE,
+      });
+      cached = credentials ? credentials.password : null;
+    } catch (error) {
+      logger.warn('secureStorage: falha ao ler o token', { error });
+      cached = null;
+    }
+    return cached;
+  };
+
+  return {
+    loadToken,
+
+    async getToken() {
+      return cached !== undefined ? cached : loadToken();
+    },
+
+    async setToken(token) {
+      await Keychain.setGenericPassword(USERNAME, token, {
+        service: SERVICE,
+        accessible: Keychain.ACCESSIBLE.AFTER_FIRST_UNLOCK_THIS_DEVICE_ONLY,
+      });
+      cached = token;
+    },
+
+    async clearToken() {
+      cached = null;
+      try {
+        await Keychain.resetGenericPassword({ service: SERVICE });
+      } catch (error) {
+        logger.warn('secureStorage: falha ao apagar o token', { error });
+      }
+    },
+  };
+}
+
+export const secureStorage = createSecureStorage();
