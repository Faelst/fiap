+
+  it('aceita lista de IPs, sub-redes e os nomes do express', () => {
+    expect(
+      parseTrustProxy(
+        ' loopback, 10.0.0.0/8 ,172.16.0.1, ::1, fd00::/8, uniquelocal, linklocal,',
+      ),
+    ).toEqual([
+      'loopback',
+      '10.0.0.0/8',
+      '172.16.0.1',
+      '::1',
+      'fd00::/8',
+      'uniquelocal',
+      'linklocal',
