+
+  it.each([
+    '-1',
+    '1.5',
+    'sim',
+    'proxy.example.com',
+    '10.0.0.0/33',
+    '::1/129',
+    '10.0.0.0/',
+    '10.0.0.0/8/1',
+    '999.0.0.1',
+    'loopback, abc',
