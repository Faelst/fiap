+import { parseTrustProxy } from './trust-proxy';
+
+describe('parseTrustProxy', () => {
+  it.each(['false', 'FALSE', ' false ', ''])(
+    'desliga com "%s" (padrão: não confia em proxy)',
+    (value) => {
+      expect(parseTrustProxy(value)).toBe(false);
