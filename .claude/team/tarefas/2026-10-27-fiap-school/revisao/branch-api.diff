+        id: 'empate',
+        reportCards: [],
+        agendaDays: [
+          {
+            date: '2025-03-17',
+            lessons: [
+              lesson('07:15', '08:00', 'Segunda', 1),
+              lesson('07:15', '08:00', 'Primeira', 0),
