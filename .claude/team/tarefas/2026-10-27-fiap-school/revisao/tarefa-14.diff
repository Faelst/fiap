+# Agenda do Rafael (semana de 16 a 22/03/2025): troca de dia pelo dropdown e
+# confere as aulas; domingo mostra o estado vazio. Não depende do dia de hoje.
+appId: br.com.fiap.school
+name: 04 - Agenda navega entre os dias
+tags:
+  - agenda
+---
+- runFlow: subflows/launch-clean.yaml
+- runFlow:
+    file: subflows/login.yaml
+    env:
+      CPF: '96929456004'
+      PASSWORD: '123456'
+- extendedWaitUntil:
+    visible:
+      id: agenda-day-dropdown
+    timeout: 10000
+- runFlow:
+    file: subflows/select-student.yaml
+    env:
+      RM: '12567'
+- assertVisible:
+    text: '(?i)aluno rafael,.*'
+
+# Segunda, 17/03: começa com Matemática I às 07:15.
+- tapOn:
+    id: agenda-day-dropdown
+- tapOn:
+    id: agenda-day-dropdown-option-2025-03-17
+- extendedWaitUntil:
+    visible:
+      id: agenda-day-dropdown
+      text: '.*17 de março, segunda-feira'
+    timeout: 5000
+- assertVisible:
+    id: agenda-lesson-0
+    text: '.*07:15.*Matemática I'
+
+# Terça, 18/03: começa com Produção e Interpretação de Textos.
+- tapOn:
+    id: agenda-day-dropdown
+- tapOn:
+    id: agenda-day-dropdown-option-2025-03-18
+- extendedWaitUntil:
+    visible:
+      id: agenda-day-dropdown
+      text: '.*18 de março, terça-feira'
+    timeout: 5000
+- assertVisible:
+    id: agenda-lesson-0
+    text: '.*07:15.*Produção e Interpretação de Textos'
+
+# Domingo, 16/03: sem aulas.
+- tapOn:
+    id: agenda-day-dropdown
+- tapOn:
+    id: agenda-day-dropdown-option-2025-03-16
+- extendedWaitUntil:
+    visible:
+      id: agenda-empty
+    timeout: 5000
+- assertVisible:
+    text: 'Sem aulas neste dia'
+- assertNotVisible:
+    id: agenda-lesson-list
