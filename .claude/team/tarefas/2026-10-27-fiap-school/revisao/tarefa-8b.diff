@@ -0,0 +1,304 @@
+import { act, renderHook } from '@testing-library/react-native';
+import { useReducedMotion } from 'react-native-reanimated';
+
+import { ApiError } from '../../../services/http/errors';
+import { useBootStore } from '../../../stores/boot.store';
+import { useSessionStore } from '../../../stores/session.store';
+import { meResponse, meWithoutStudents } from '../../../test/fixtures';
+import { loadMeOnBoot } from '../../auth/api/loadMeOnBoot';
+import { useSplashViewModel } from '../useSplashViewModel';
+
+jest.mock('react-native-reanimated', () => ({
+  ...require('react-native-reanimated/mock'),
+  useReducedMotion: jest.fn(() => false),
+}));
+
+jest.mock('../../auth/api/loadMeOnBoot', () => ({
+  loadMeOnBoot: jest.fn(),
+}));
+
+const loadMe = jest.mocked(loadMeOnBoot);
+const reducedMotion = jest.mocked(useReducedMotion);
+
+/** Promessa que só termina quando o signal é abortado (API pendurada). */
+const hangUntilAborted = ({ signal }: { signal?: AbortSignal }) =>
+  new Promise<never>((_resolve, reject) => {
+    signal?.addEventListener('abort', () => reject(new ApiError('canceled')));
+  });
+
+const setup = async () => {
+  const navigation = { reset: jest.fn() };
+  const hook = await renderHook(() => useSplashViewModel(navigation));
+  return { ...hook, navigation };
+};
+
+const advance = (ms: number) =>
+  act(async () => {
+    await jest.advanceTimersByTimeAsync(ms);
+  });
+
+describe('useSplashViewModel', () => {
+  beforeEach(() => {
+    jest.useFakeTimers();
+    loadMe.mockReset();
+    reducedMotion.mockReturnValue(false);
+    useSessionStore.setState({ status: 'loading' });
+    useBootStore.setState({ splashDone: false });
+  });
+
+  afterEach(() => {
+    jest.useRealTimers();
+  });
+
+  it('sem token vai para o Login só depois da duração mínima (1200 ms)', async () => {
+    useSessionStore.setState({ status: 'signedOut' });
+    const { result } = await setup();
+
+    await advance(1199);
+    expect(result.current.destination).toBeNull();
+
+    await advance(1);
+    expect(result.current.destination).toBe('login');
+    expect(loadMe).not.toHaveBeenCalled();
+  });
+
+  it('espera o bootstrap do keychain antes de decidir', async () => {
+    const { result } = await setup();
+
+    await advance(400);
+    await act(() => useSessionStore.setState({ status: 'signedOut' }));
+    await advance(800);
+
+    expect(result.current.destination).toBe('login');
+  });
+
+  it('com token valida o /me com timeout de 8 s e vai para as abas quando há aluno', async () => {
+    useSessionStore.setState({ status: 'signedIn' });
+    loadMe.mockResolvedValue(meResponse);
+    const { result } = await setup();
+
+    await advance(1200);
+
+    expect(result.current.destination).toBe('app');
+    expect(loadMe).toHaveBeenCalledTimes(1);
+    expect(loadMe).toHaveBeenCalledWith(
+      expect.objectContaining({ timeoutMs: 8000 }),
+    );
+  });
+
+  it('com token e /me sem aluno vai para NoStudent', async () => {
+    useSessionStore.setState({ status: 'signedIn' });
+    loadMe.mockResolvedValue(meWithoutStudents);
+    const { result } = await setup();
+
+    await advance(1200);
+
+    expect(result.current.destination).toBe('noStudent');
+  });
+
+  it.each(['network', 'server', 'invalidResponse', 'forbidden'] as const)(
+    'erro %s no /me vai para BootError',
+    async kind => {
+      useSessionStore.setState({ status: 'signedIn' });
+      loadMe.mockRejectedValue(new ApiError(kind));
+      const { result } = await setup();
+
+      await advance(1200);
+
+      expect(result.current.destination).toBe('bootError');
+    },
+  );
+
+  it('/me 401 vai para o Login', async () => {
+    useSessionStore.setState({ status: 'signedIn' });
+    loadMe.mockRejectedValue(new ApiError('unauthorized', { status: 401 }));
+    const { result } = await setup();
+
+    await advance(1200);
+
+    expect(result.current.destination).toBe('login');
+  });
+
+  it('/me lento: decide quando a resposta chega, depois do mínimo', async () => {
+    useSessionStore.setState({ status: 'signedIn' });
+    loadMe.mockImplementation(
+      () =>
+        new Promise(resolve => {
+          setTimeout(() => resolve(meResponse), 3000);
+        }),
+    );
+    const { result } = await setup();
+
+    await advance(2999);
+    expect(result.current.destination).toBeNull();
+
+    await advance(1);
+    expect(result.current.destination).toBe('app');
+  });
+
+  it('canceled não é erro de tela: não vai para BootError na hora', async () => {
+    useSessionStore.setState({ status: 'signedIn' });
+    loadMe.mockRejectedValue(new ApiError('canceled'));
+    const { result } = await setup();
+
+    await advance(5000);
+
+    expect(result.current.destination).toBeNull();
+  });
+
+  it('trava de 10 s com token: vai para BootError e cancela o /me', async () => {
+    useSessionStore.setState({ status: 'signedIn' });
+    let signal: AbortSignal | undefined;
+    loadMe.mockImplementation(options => {
+      signal = options.signal;
+      return hangUntilAborted(options);
+    });
+    const { result } = await setup();
+
+    await advance(9999);
+    expect(result.current.destination).toBeNull();
+
+    await advance(1);
+    expect(result.current.destination).toBe('bootError');
+    expect(signal?.aborted).toBe(true);
+  });
+
+  it('trava de 10 s sem token (keychain não respondeu): vai para o Login', async () => {
+    const { result } = await setup();
+
+    await advance(9999);
+    expect(result.current.destination).toBeNull();
+
+    await advance(1);
+    expect(result.current.destination).toBe('login');
+  });
+
+  it('com reduzir movimento a duração mínima é 600 ms', async () => {
+    reducedMotion.mockReturnValue(true);
+    useSessionStore.setState({ status: 'signedOut' });
+    const { result } = await setup();
+
+    await advance(599);
+    expect(result.current.destination).toBeNull();
+
+    await advance(1);
+    expect(result.current.destination).toBe('login');
+    expect(result.current.reducedMotion).toBe(true);
+  });
+
+  it('desmontar antes de decidir cancela o /me e não navega', async () => {
+    useSessionStore.setState({ status: 'signedIn' });
+    let signal: AbortSignal | undefined;
+    loadMe.mockImplementation(options => {
+      signal = options.signal;
+      return hangUntilAborted(options);
+    });
+    const { unmount, navigation } = await setup();
+
+    await advance(500);
+    await act(async () => unmount());
+    await advance(10_000);
+
+    expect(signal?.aborted).toBe(true);
+    expect(navigation.reset).not.toHaveBeenCalled();
+  });
+
+  describe('loop de espera', () => {
+    it('aparece em 1500 ms se a sessão ainda não resolveu', async () => {
+      useSessionStore.setState({ status: 'signedIn' });
+      loadMe.mockImplementation(hangUntilAborted);
+      const { result } = await setup();
+
+      await advance(1499);
+      expect(result.current.showLoader).toBe(false);
+
+      await advance(1);
+      expect(result.current.showLoader).toBe(true);
+    });
+
+    it('não aparece quando o destino sai no mínimo', async () => {
+      useSessionStore.setState({ status: 'signedOut' });
+      const { result } = await setup();
+
+      await advance(3000);
+
+      expect(result.current.destination).toBe('login');
+      expect(result.current.showLoader).toBe(false);
+    });
+
+    it('some quando a sessão resolve depois dele', async () => {
+      useSessionStore.setState({ status: 'signedIn' });
+      loadMe.mockImplementation(
+        () =>
+          new Promise(resolve => {
+            setTimeout(() => resolve(meResponse), 2500);
+          }),
+      );
+      const { result } = await setup();
+
+      await advance(1500);
+      expect(result.current.showLoader).toBe(true);
+
+      await advance(1000);
+      expect(result.current.destination).toBe('app');
+      expect(result.current.showLoader).toBe(false);
+    });
+  });
+
+  describe('fim da saída', () => {
+    it('Login: reset com fromSplash e a splash sai do stack', async () => {
+      useSessionStore.setState({ status: 'signedOut' });
+      const { result, navigation } = await setup();
+      await advance(1200);
+
+      await act(() => result.current.onExitFinished());
+
+      expect(navigation.reset).toHaveBeenCalledWith({
+        index: 0,
+        routes: [{ name: 'Login', params: { fromSplash: true } }],
+      });
+      expect(useBootStore.getState().splashDone).toBe(true);
+    });
+
+    it.each([
+      [meResponse, 'App', { screen: 'Agenda', fromSplash: true }],
+      [meWithoutStudents, 'NoStudent', { fromSplash: true }],
+    ] as const)('/me ok: reset para %#', async (me, name, params) => {
+      useSessionStore.setState({ status: 'signedIn' });
+      loadMe.mockResolvedValue(me);
+      const { result, navigation } = await setup();
+      await advance(1200);
+
+      await act(() => result.current.onExitFinished());
+
+      expect(navigation.reset).toHaveBeenCalledWith({
+        index: 0,
+        routes: [{ name, params }],
+      });
+    });
+
+    it('BootError: reset para BootError', async () => {
+      useSessionStore.setState({ status: 'signedIn' });
+      loadMe.mockRejectedValue(new ApiError('network'));
+      const { result, navigation } = await setup();
+      await advance(1200);
+
+      await act(() => result.current.onExitFinished());
+
+      expect(navigation.reset).toHaveBeenCalledWith({
+        index: 0,
+        routes: [{ name: 'BootError', params: { fromSplash: true } }],
+      });
+    });
+
+    it('sem destino ainda, não navega', async () => {
+      useSessionStore.setState({ status: 'signedOut' });
+      const { result, navigation } = await setup();
+
+      await act(() => result.current.onExitFinished());
+
+      expect(navigation.reset).not.toHaveBeenCalled();
+      expect(useBootStore.getState().splashDone).toBe(false);
+    });
+  });
+});
diff --git a/mobile/src/features/splash/useSplashAnimation.ts b/mobile/src/features/splash/useSplashAnimation.ts
new file mode 100644
index 0000000..2452964
--- /dev/null
+++ b/mobile/src/features/splash/useSplashAnimation.ts
@@ -0,0 +1,243 @@
+import { useCallback } from 'react';
+import {
+  cancelAnimation,
+  Easing,
+  useAnimatedStyle,
+  useSharedValue,
+  withDelay,
+  withRepeat,
+  withSequence,
+  withSpring,
+  withTiming,
+} from 'react-native-reanimated';
+import { scheduleOnRN } from 'react-native-worklets';
+
+import { useTheme } from '../../theme';
+import type { SplashDestination } from './useSplashViewModel';
+
+type Options = {
+  reducedMotion: boolean;
+  /** Largura do trilho de espera (a do logo). */
+  trackWidth: number;
+};
+
+type ExitOptions = {
+  destination: SplashDestination;
+  /** Deslocamento do centro até a posição do logo do Login. */
+  loginOffsetY: number;
+  onFinished: () => void;
+};
+
+const linear = Easing.linear;
+
+/**
+ * Timeline da splash (01-design.md, 3.1.3 a 3.1.6), toda em shared values no
+ * UI thread. Cada função dispara as animações de uma vez; o JS não participa
+ * enquanto elas rodam. O fim da saída volta ao JS por `scheduleOnRN`.
+ */
+export function useSplashAnimation({ reducedMotion, trackWidth }: Options) {
+  const { motion, sizes } = useTheme();
+  const splash = motion.splash;
+  const segmentWidth = trackWidth * splash.loopTrackSegment;
+  const segmentCenter = (trackWidth - segmentWidth) / 2;
+
+  // Com reduzir movimento, o logo já nasce montado (selo à vista, escala 1)
+  // e só a opacidade do grupo anima.
+  const groupOpacity = useSharedValue(reducedMotion ? 0 : 1);
+  const groupScale = useSharedValue(reducedMotion ? 1 : splash.scaleFrom);
+  const groupY = useSharedValue(0);
+  const wipeX = useSharedValue(0);
+  const scanOpacity = useSharedValue(0);
+  const badgeOpacity = useSharedValue(reducedMotion ? 1 : 0);
+  const badgeScale = useSharedValue(reducedMotion ? 1 : splash.badgeScaleFrom);
+  const badgeBreath = useSharedValue(1);
+  const loaderOpacity = useSharedValue(0);
+  const loaderX = useSharedValue(reducedMotion ? segmentCenter : -segmentWidth);
+
+  const start = useCallback(() => {
+    if (reducedMotion) {
+      groupOpacity.set(
+        withTiming(1, { duration: splash.fadeInReduced, easing: linear }),
+      );
+      return;
+    }
+    const { delay, duration } = splash.wipe;
+    wipeX.set(
+      withDelay(
+        delay,
+        withTiming(sizes.logoLogin.width + sizes.scanLine.width, {
+          duration,
+          easing: splash.wipeEasing,
+        }),
+      ),
+    );
+    scanOpacity.set(
+      withDelay(
+        delay,
+        withSequence(
+          withTiming(1, { duration: splash.scanFadeIn, easing: linear }),
+          withDelay(
+            duration - splash.scanFadeIn - splash.scanFadeOut,
+            withTiming(0, { duration: splash.scanFadeOut, easing: linear }),
+          ),
+        ),
+      ),
+    );
+    groupScale.set(
+      withDelay(
+        delay,
+        withTiming(1, {
+          duration: splash.scaleDuration,
+          easing: motion.easeOut,
+        }),
+      ),
+    );
+    badgeOpacity.set(
+      withDelay(
+        splash.badgeAt,
+        withTiming(1, { duration: splash.badgeFadeIn, easing: linear }),
+      ),
+    );
+    badgeScale.set(
+      withDelay(splash.badgeAt, withSpring(1, splash.badgeSpring)),
+    );
+  }, [
+    reducedMotion,
+    splash,
+    sizes.logoLogin.width,
+    sizes.scanLine.width,
+    motion.easeOut,
+    groupOpacity,
+    wipeX,
+    scanOpacity,
+    groupScale,
+    badgeOpacity,
+    badgeScale,
+  ]);
+
+  const startLoop = useCallback(() => {
+    loaderOpacity.set(withTiming(1, { duration: motion.fast }));
+    if (reducedMotion) {
+      // Trilho parado, segmento no centro.
+      return;
+    }
+    loaderX.set(
+      withRepeat(
+        withTiming(trackWidth, {
+          duration: splash.loopTrack,
+          easing: Easing.inOut(Easing.cubic),
+        }),
+        -1,
+        false,
+      ),
+    );
+    const half = splash.badgeBreath / 2;
+    const breathEasing = Easing.inOut(Easing.sin);
+    badgeBreath.set(
+      withRepeat(
+        withSequence(
+          withTiming(splash.badgeBreathScale, {
+            duration: half,
+            easing: breathEasing,
+          }),
+          withTiming(1, { duration: half, easing: breathEasing }),
+        ),
+        -1,
+        false,
+      ),
+    );
+  }, [
+    reducedMotion,
+    trackWidth,
+    splash,
+    motion.fast,
+    loaderOpacity,
+    loaderX,
+    badgeBreath,
+  ]);
+
+  const exit = useCallback(
+    ({ destination, loginOffsetY, onFinished }: ExitOptions) => {
+      // Para o loop sem esperar o ciclo acabar.
+      cancelAnimation(loaderX);
+      cancelAnimation(badgeBreath);
+      loaderOpacity.set(withTiming(0, { duration: motion.fast }));
+      badgeBreath.set(withTiming(1, { duration: motion.fast }));
+
+      const done = (finished?: boolean) => {
+        'worklet';
+        if (finished) scheduleOnRN(onFinished);
+      };
+
+      if (reducedMotion) {
+        groupOpacity.set(
+          withTiming(0, { duration: motion.fast, easing: linear }, done),
+        );
+        return;
+      }
+      if (destination === 'login') {
+        groupY.set(
+          withTiming(
+            loginOffsetY,
+            { duration: motion.slow, easing: splash.exitToLoginEasing },
+            done,
+          ),
+        );
+        return;
+      }
+      const config = { duration: splash.exitDuration, easing: motion.easeIn };
+      groupScale.set(withTiming(splash.exitScaleTo, config));
+      groupOpacity.set(withTiming(0, config, done));
+    },
+    [
+      reducedMotion,
+      splash,
+      motion.fast,
+      motion.slow,
+      motion.easeIn,
+      loaderX,
+      badgeBreath,
+      loaderOpacity,
+      groupOpacity,
+      groupY,
+      groupScale,
+    ],
+  );
+
+  const groupStyle = useAnimatedStyle(() => ({
+    opacity: groupOpacity.get(),
+    transform: [{ translateY: groupY.get() }, { scale: groupScale.get() }],
+  }));
+  const maskStyle = useAnimatedStyle(() => ({
+    transform: [{ translateX: wipeX.get() }],
+  }));
+  const scanStyle = useAnimatedStyle(() => ({
+    opacity: scanOpacity.get(),
+    transform: [{ translateX: wipeX.get() }],
+  }));
+  const badgeStyle = useAnimatedStyle(() => ({
+    opacity: badgeOpacity.get(),
+    transform: [{ scale: badgeScale.get() * badgeBreath.get() }],
+  }));
+  const loaderStyle = useAnimatedStyle(() => ({
+    opacity: loaderOpacity.get(),
+  }));
+  const segmentStyle = useAnimatedStyle(() => ({
+    transform: [{ translateX: loaderX.get() }],
+  }));
+
+  return {
+    start,
+    startLoop,
+    exit,
+    segmentWidth,
+    styles: {
+      group: groupStyle,
+      mask: maskStyle,
+      scan: scanStyle,
+      badge: badgeStyle,
+      loader: loaderStyle,
+      segment: segmentStyle,
+    },
+  };
+}
