+  title: '1º TRIMESTRE',
+  accessibilityLabel: '1º trimestre',
+  expanded: false,
+  subjects: [
+    portugues,
+    {
+      ...portugues,
+      key: '1-1',
+      index: 1,
+      name: 'Matemática',
+      grade: '8,0',
+      absences: '2',
+      resultAccessibilityLabel: 'Nota 8,0, 2 faltas',
+    },
+  ],
