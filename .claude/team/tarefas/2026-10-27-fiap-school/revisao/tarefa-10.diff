new file mode 100644
index 0000000..60c4fda
--- /dev/null
+++ b/mobile/src/features/students/useSelectStudentViewModel.ts
@@ -0,0 +1,64 @@
+import { useEffect, useRef, useState } from 'react';
+
+import type { RootStackScreenProps } from '../../navigation/types';
+import { useSessionStore } from '../../stores/session.store';
+import { motion } from '../../theme';
+import { fullName } from '../../utils/names';
+import { useSessionStudent } from './useSessionStudent';
+
+type SelectStudentNavigation = Pick<
+  RootStackScreenProps<'SelectStudent'>['navigation'],
+  'goBack'
+>;
+
+/** A borda do card acende e o modal fecha logo depois (01-design.md, 4.7). */
+const BACK_DELAY = motion.fast + motion.selectStudentBackDelay;
+
+/**
+ * Seleção de aluno (R9, M6). Escolher outro aluno marca o card na hora e,
+ * depois do atraso, troca o aluno no store e volta para a aba de origem, que
+ * já lê as queries do aluno novo (as keys levam o id). O aluno atual e o
+ * FECHAR só voltam.
+ */
+export function useSelectStudentViewModel(navigation: SelectStudentNavigation) {
+  const { students, student } = useSessionStudent();
+  const selectStudent = useSessionStore(state => state.selectStudent);
+  const [chosenId, setChosenId] = useState<string | null>(null);
+  const timer = useRef<ReturnType<typeof setTimeout> | null>(null);
+
+  useEffect(
+    () => () => {
+      if (timer.current) clearTimeout(timer.current);
+    },
+    [],
+  );
+
+  const selectedId = chosenId ?? student?.id ?? null;
+
+  const onSelect = (id: string) => {
+    if (chosenId !== null) return;
+    if (id === student?.id) {
+      navigation.goBack();
+      return;
+    }
+    setChosenId(id);
+    timer.current = setTimeout(() => {
+      timer.current = null;
+      selectStudent(id);
+      navigation.goBack();
+    }, BACK_DELAY);
+  };
+
+  return {
+    students: students.map(item => ({
+      id: item.id,
+      fullName: fullName(item.firstName, item.lastName),
+      rm: item.rm,
+      className: item.className,
+      period: item.period,
+      selected: item.id === selectedId,
+    })),
+    onSelect,
+    onClose: () => navigation.goBack(),
+  };
+}
diff --git a/mobile/src/features/students/useSessionStudent.ts b/mobile/src/features/students/useSessionStudent.ts
new file mode 100644
index 0000000..81544ef
--- /dev/null
+++ b/mobile/src/features/students/useSessionStudent.ts
@@ -0,0 +1,37 @@
+import { useEffect } from 'react';
+
+import { useSessionStore } from '../../stores/session.store';
+import { firstName } from '../../utils/names';
+import { useMeQuery } from '../auth/api/useMeQuery';
+import type { Student } from '../auth/schemas';
+import { resolveSelectedStudent } from './selectedStudent';
+
+const NO_STUDENTS: readonly Student[] = [];
+
+/**
+ * Responsável e aluno em uso, a partir do `/me` (já em cache depois da splash
+ * ou do login) e do `selectedStudentId` do store. Quando o aluno salvo falta
+ * ou não é mais deste responsável, mostra o primeiro e grava a troca, para
+ * as queries por aluno usarem o mesmo id.
+ */
+export function useSessionStudent() {
+  const { data: me } = useMeQuery();
+  const selectedId = useSessionStore(state => state.selectedStudentId);
+  const selectStudent = useSessionStore(state => state.selectStudent);
+
+  const students = me?.students ?? NO_STUDENTS;
+  const student = resolveSelectedStudent(students, selectedId);
+  const studentId = student?.id ?? null;
+
+  useEffect(() => {
+    if (studentId !== null && studentId !== selectedId) {
+      selectStudent(studentId);
+    }
+  }, [studentId, selectedId, selectStudent]);
+
+  return {
+    guardianFirstName: me ? firstName(me.firstName) : '',
+    students,
+    student,
+  };
+}
