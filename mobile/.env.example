# Copie para .env (o .env não é versionado) e refaça o build nativo:
# o react-native-config grava estes valores no binário.
#
# iOS simulator: localhost enxerga a API da máquina.
# Emulador Android: use http://10.0.2.2:3333/api (o app troca localhost por
# 10.0.2.2 sozinho no Android). Aparelho físico: o IP da máquina na rede.
# Sem API_URL, o app usa http://localhost:3333/api (iOS) e
# http://10.0.2.2:3333/api (Android).
API_URL=http://localhost:3333/api
