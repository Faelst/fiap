# Caminho do SQLite, relativo à pasta api/ (onde os comandos rodam)
DATABASE_URL="file:./dev.db"
PORT=3333
# Troque por um segredo longo e aleatório fora do ambiente local
JWT_SECRET="troque-este-segredo-local"
JWT_EXPIRES_IN=7d
# Lista separada por vírgula, ou * para liberar todas (só em dev)
CORS_ORIGINS=*
