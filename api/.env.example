# Caminho do SQLite, relativo à pasta api/ (onde os comandos rodam)
DATABASE_URL="file:./dev.db"
PORT=3333
# Segredo do JWT (HS256), com 32+ caracteres. Este valor é público: serve só
# local, e com NODE_ENV=production a API recusa subir com ele.
# Gere um com: openssl rand -base64 48
JWT_SECRET="exemplo-local-troque-este-segredo-antes-de-publicar"
# Validade do token: número com unidade obrigatória s, m, h, d, w ou y (ex.: 3600s, 30m, 7d)
JWT_EXPIRES_IN=7d
# Lista separada por vírgula, ou * para liberar todas (só em dev). Sem a
# variável: * fora de produção; com NODE_ENV=production ela é obrigatória
CORS_ORIGINS=*
# Rate limit do login: tentativas por IP dentro da janela (ms). Padrão 5 por minuto
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_MS=60000
# Limite de FALHAS de login por CPF (vale para qualquer IP): segura força bruta
# com rodízio de IPs. Login certo não conta e zera as falhas. Padrão 10 falhas
# em 15 min (a janela conta da primeira falha). Quem souber um CPF consegue
# travar o login dele por essa janela (custo aceito)
LOGIN_THROTTLE_CPF_LIMIT=10
LOGIN_THROTTLE_CPF_TTL_MS=900000
# development = log no pino-pretty. Qualquer outro valor (ou sem a variável)
# sai em JSON; o Docker usa production
NODE_ENV=development
# Logs (pino): fatal, error, warn, info, debug, trace ou silent
LOG_LEVEL=info
# Swagger em /docs e /docs-json (true ou false). Sem a variável: ligado fora
# de produção e desligado com NODE_ENV=production
SWAGGER_ENABLED=true
# trust proxy do express (decide o IP do rate limit): false (sem proxy), número
# de saltos (ex.: 1) ou lista de IPs/sub-redes (ex.: loopback,10.0.0.0/8).
# true é recusado: confiaria em qualquer X-Forwarded-For e anularia o rate limit
TRUST_PROXY=false
# Seed (prisma:setup / prisma:seed): num banco que já tem dados o seed não faz
# nada, para manter ids e tokens. true apaga e recria tudo a partir do JSON
SEED_RESET=false
